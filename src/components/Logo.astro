---
interface Props {
  class?: string;
  mono?: boolean;
}
const { class: className = '', mono = false } = Astro.props;
---
<a href="/" class={`group inline-flex items-center gap-2.5 ${className}`} aria-label="Maison home">
  <span class="relative inline-flex h-7 w-7 items-center justify-center overflow-hidden border border-ink/15 bg-ink text-paper">
    <svg viewBox="0 0 32 32" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path d="M6 22V10l5 9 5-9v12M19 22V10h4.5a3 3 0 0 1 0 6H19" class="text-brass-300" stroke="currentColor" stroke-linecap="square"/>
    </svg>
    <span class="absolute inset-0 bg-brass/20 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
  </span>
  <span class={`font-display text-[1.05rem] tracking-tight ${mono ? 'text-paper' : 'text-ink'}`}>
    Maison<span class="text-brass-500">.</span>
  </span>
</a>
