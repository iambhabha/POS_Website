---
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---
<a href="/" class="group inline-flex items-center gap-2.5 font-semibold">
  <span
    class="relative grid place-items-center rounded-xl text-white shadow-lg transition-transform duration-500 group-hover:rotate-[8deg]"
    style={`width:${size}px;height:${size}px;background:linear-gradient(135deg,#3b5bff,#ff3d8a 55%,#19e3b3);`}
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 14l4-9 4 9M7.5 11.5h5" />
      <circle cx="17.5" cy="8.5" r="1.6" />
    </svg>
    <span class="absolute inset-0 rounded-xl opacity-0 blur-md transition-opacity duration-500 group-hover:opacity-60" style="background:inherit;"></span>
  </span>
  <span class="text-lg tracking-tight">Barista<span class="gradient-text">.</span></span>
</a>
