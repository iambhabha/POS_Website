---
interface Props {
  title: string;
  description: string;
  icon: string;
  gradient?: string;
  delay?: number;
}
const { title, description, icon, gradient = "from-brand-500 to-accent-500", delay = 0 } = Astro.props;
---
<article class="reveal group relative" style={`transition-delay:${delay}ms`}>
  <div class="card-3d relative rounded-3xl glass p-6 transition-colors duration-300 group-hover:border-white/20">
    <div class={`tilt-layer grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br ${gradient} text-white shadow-lg`}>
      <Fragment set:html={icon} />
    </div>
    <h3 class="tilt-layer mt-5 text-lg font-semibold">{title}</h3>
    <p class="tilt-layer mt-2 text-sm text-[var(--text-muted)]">{description}</p>

    <div class="pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background:radial-gradient(300px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.12), transparent 45%);"></div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>(".group").forEach((el) => {
    el.addEventListener("mousemove", (e) => {
      const rect = el.getBoundingClientRect();
      el.style.setProperty("--mx", `${e.clientX - rect.left}px`);
      el.style.setProperty("--my", `${e.clientY - rect.top}px`);
    });
  });
</script>
