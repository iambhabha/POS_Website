---
interface Props {
  index?: string;
  title: string;
  body: string;
  icon?: 'pos' | 'calendar' | 'inventory' | 'guests' | 'insights' | 'rooms' | 'staff' | 'menu';
  tone?: 'paper' | 'warm' | 'ink';
  class?: string;
}
const { index = '', title, body, icon = 'pos', tone = 'paper', class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  pos:       '<path d="M4 6h16M4 6v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6M4 6l2-3h12l2 3M8 12h4M8 16h8" stroke-linecap="square"/>',
  calendar:  '<rect x="3" y="5" width="18" height="16" rx="0.5"/><path d="M3 9h18M8 3v4M16 3v4M8 14h2M12 14h2M16 14h2M8 18h2M12 18h2" stroke-linecap="square"/>',
  inventory: '<path d="M4 7l8-4 8 4v10l-8 4-8-4V7Z"/><path d="M4 7l8 4 8-4M12 11v10" stroke-linecap="square"/>',
  guests:    '<circle cx="9" cy="9" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="7" r="2.5"/><path d="M14 14a4.5 4.5 0 0 1 7 3.6" stroke-linecap="square"/>',
  insights:  '<path d="M4 20V9M10 20V4M16 20v-7M22 20H2" stroke-linecap="square"/>',
  rooms:     '<path d="M3 10l9-6 9 6v10H3V10Z"/><path d="M9 20v-6h6v6M3 10h18" stroke-linecap="square"/>',
  staff:     '<circle cx="12" cy="8" r="3.5"/><path d="M5 21a7 7 0 0 1 14 0" stroke-linecap="square"/>',
  menu:      '<path d="M6 3v18M18 3v18M10 7h4M10 12h4M10 17h4" stroke-linecap="square"/>',
};

const toneClass =
  tone === 'ink' ? 'bg-ink text-paper border-ink' :
  tone === 'warm' ? 'bg-paper-warm border-ink/10' :
  'bg-paper border-ink/10';
---
<article data-reveal
         class={`group relative overflow-hidden border p-8 transition-all duration-500 ease-out hover:-translate-y-1 ${toneClass} ${className}`}>
  <!-- Index + icon -->
  <div class="flex items-start justify-between">
    {index && (
      <span class={`mono text-[0.68rem] tracking-[0.2em] ${tone === 'ink' ? 'text-paper/50' : 'text-ink-400'}`}>
        {index}
      </span>
    )}
    <svg viewBox="0 0 24 24" class={`h-8 w-8 stroke-[1.25] ${tone === 'ink' ? 'text-brass-300' : 'text-ink'}`} fill="none" stroke="currentColor" aria-hidden="true" set:html={icons[icon]} />
  </div>

  <h3 class={`mt-10 font-display text-2xl leading-tight tracking-tight ${tone === 'ink' ? 'text-paper' : 'text-ink'}`}>
    {title}
  </h3>
  <p class={`mt-3 text-[0.95rem] leading-relaxed ${tone === 'ink' ? 'text-paper/70' : 'text-ink-500'}`}>
    {body}
  </p>

  <!-- Hover accent line -->
  <span class="absolute inset-x-8 bottom-0 block h-px origin-left scale-x-0 bg-brass-500 transition-transform duration-500 ease-out group-hover:scale-x-100"></span>

  <slot />
</article>
