---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "/features", label: "Features" },
  { href: "/pricing", label: "Pricing" },
  { href: "/payment", label: "Payment" },
  { href: "/download", label: "Download" },
  { href: "/contact", label: "Contact" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-50 w-full">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-[var(--bg)]/95 to-transparent"></div>
  <div class="relative mx-auto flex w-full max-w-7xl items-center justify-between gap-6 px-5 py-3.5">
    <div class="flex w-full items-center justify-between rounded-xl border border-[var(--surface-border)] bg-[var(--surface)] px-4 py-2 shadow-sm">
      <Logo />

      <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
        {nav.map((item) => {
          const active = pathname === item.href;
          return (
            <a
              href={item.href}
              class:list={[
                "relative rounded-md px-3 py-1.5 text-sm font-medium transition-colors",
                active
                  ? "bg-[var(--bg-soft)] text-[var(--text)]"
                  : "text-[var(--text-muted)] hover:text-[var(--text)]",
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle />
        <a href="/payment" class="hidden btn-primary !py-2 !px-4 text-sm sm:inline-flex">Buy Atithya</a>
        <button
          id="mobile-nav-btn"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="grid h-10 w-10 place-items-center rounded-md border border-[var(--surface-border)] bg-[var(--bg-soft)] md:hidden"
          type="button"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-nav" class="hidden md:hidden" aria-label="Mobile navigation">
    <div class="mx-auto max-w-7xl px-5 pb-3">
      <div class="rounded-xl border border-[var(--surface-border)] bg-[var(--surface)] p-3 shadow-sm">
        {nav.map((item) => (
          <a href={item.href} class="mobile-nav-link block rounded-md px-4 py-2.5 text-sm font-medium text-[var(--text-muted)] hover:bg-[var(--bg-soft)] hover:text-[var(--text)]">{item.label}</a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-nav-btn");
  const menu = document.getElementById("mobile-nav");
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link");

  function setMenuState(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle("hidden", !open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  }

  btn?.addEventListener("click", () => {
    const isOpen = btn.getAttribute("aria-expanded") === "true";
    setMenuState(!isOpen);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => setMenuState(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuState(false);
  });

  document.addEventListener("click", (event) => {
    if (!menu || !btn) return;
    const target = event.target as Node;
    const clickedInside = menu.contains(target) || btn.contains(target);
    if (!clickedInside) setMenuState(false);
  });
</script>
