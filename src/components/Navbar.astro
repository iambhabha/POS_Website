---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "/features", label: "Features" },
  { href: "/pricing", label: "Pricing" },
  { href: "/download", label: "Download" },
  { href: "/dashboard", label: "Dashboard" },
  { href: "/admin", label: "Admin" },
  { href: "/contact", label: "Contact" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-50 w-full">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-white/60 dark:from-black/40 to-transparent blur-sm"></div>
  <div class="relative mx-auto flex w-full max-w-7xl items-center justify-between gap-6 px-5 py-3.5">
    <div class="glass flex w-full items-center justify-between rounded-full px-4 py-2 shadow-sm">
      <Logo />

      <nav class="hidden items-center gap-1 md:flex">
        {nav.map((item) => {
          const active = pathname === item.href;
          return (
            <a
              href={item.href}
              class:list={[
                "relative rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors",
                active ? "text-white" : "hover:text-brand-600 dark:hover:text-brand-300",
              ]}
            >
              {active && (
                <span class="absolute inset-0 -z-10 rounded-full bg-gradient-to-r from-brand-500 to-accent-500 shadow-[0_6px_20px_-8px_rgba(59,91,255,0.6)]"></span>
              )}
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle />
        <a href="/download" class="hidden btn-primary !py-2 !px-4 text-sm sm:inline-flex">Get Barista</a>
        <button
          id="mobile-nav-btn"
          aria-label="Open menu"
          class="grid h-10 w-10 place-items-center rounded-full glass md:hidden"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-nav" class="hidden md:hidden">
    <div class="mx-auto max-w-7xl px-5 pb-3">
      <div class="glass rounded-3xl p-3">
        {nav.map((item) => (
          <a href={item.href} class="block rounded-2xl px-4 py-2.5 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/5">{item.label}</a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-nav-btn");
  const menu = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
