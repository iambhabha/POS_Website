---
interface Props {
  as?: string;
  mode?: 'up' | 'scale' | 'left' | 'right';
  delay?: number;
  class?: string;
}
const { as: Tag = 'div', mode = 'up', delay = 0, class: className = '' } = Astro.props;
---
<Tag data-reveal={mode === 'up' ? '' : mode} style={`transition-delay:${delay}ms`} class={className}>
  <slot />
</Tag>
