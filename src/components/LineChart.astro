---
interface Props {
  title?: string;
  subtitle?: string;
  series?: number[];
  labels?: string[];
  height?: number;
  id?: string;
}
const {
  title = "Sales performance",
  subtitle = "Last 14 days",
  series = [12, 22, 18, 26, 30, 24, 38, 42, 36, 48, 44, 52, 58, 63],
  labels = ["Apr 6","Apr 7","Apr 8","Apr 9","Apr 10","Apr 11","Apr 12","Apr 13","Apr 14","Apr 15","Apr 16","Apr 17","Apr 18","Apr 19"],
  height = 260,
  id = "chart",
} = Astro.props;

const max = Math.max(...series);
const min = Math.min(...series);
const range = Math.max(max - min, 1);
const pad = 10;
const W = 600;
const H = height;
const step = (W - pad * 2) / (series.length - 1);
const points = series.map((v, i) => {
  const x = pad + i * step;
  const y = pad + (H - pad * 2) - ((v - min) / range) * (H - pad * 2);
  return [x, y] as const;
});
const d = points.map((p, i) => (i === 0 ? `M ${p[0]} ${p[1]}` : `L ${p[0]} ${p[1]}`)).join(" ");
const area = `${d} L ${pad + (series.length - 1) * step} ${H - pad} L ${pad} ${H - pad} Z`;
---
<article class="reveal glass rounded-3xl p-6">
  <header class="flex items-start justify-between">
    <div>
      <p class="text-sm font-semibold">{title}</p>
      <p class="text-xs text-[var(--text-muted)]">{subtitle}</p>
    </div>
    <div class="flex gap-1 rounded-full glass p-1 text-[11px]">
      {["1D","1W","1M","ALL"].map((r, i) => (
        <button class:list={["rounded-full px-2.5 py-1 transition-colors", i===1 ? "bg-gradient-to-r from-brand-500 to-accent-500 text-white" : "text-[var(--text-muted)] hover:text-[var(--text)]"]}>{r}</button>
      ))}
    </div>
  </header>

  <svg viewBox={`0 0 ${W} ${H}`} class="mt-5 w-full" preserveAspectRatio="none">
    <defs>
      <linearGradient id={`area-${id}`} x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#3b5bff" stop-opacity="0.55"/>
        <stop offset="1" stop-color="#3b5bff" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id={`stroke-${id}`} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#3b5bff"/>
        <stop offset="0.6" stop-color="#ff3d8a"/>
        <stop offset="1" stop-color="#19e3b3"/>
      </linearGradient>
    </defs>
    {[0.25, 0.5, 0.75].map((f) => (
      <line x1={pad} x2={W - pad} y1={pad + (H - pad * 2) * f} y2={pad + (H - pad * 2) * f} stroke="currentColor" stroke-opacity="0.08" />
    ))}
    <path d={area} fill={`url(#area-${id})`} />
    <path class="chart-line" d={d} fill="none" stroke={`url(#stroke-${id})`} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    {points.map(([x, y], i) => (
      <circle cx={x} cy={y} r={i === points.length - 1 ? 4.5 : 2.5} fill={i === points.length - 1 ? "#ff3d8a" : "#3b5bff"}>
        {i === points.length - 1 && <animate attributeName="r" values="4;6;4" dur="2s" repeatCount="indefinite" />}
      </circle>
    ))}
  </svg>

  <div class="mt-3 flex justify-between text-[10px] text-[var(--text-muted)]">
    {labels.filter((_, i) => i % 2 === 0).map((l) => <span>{l}</span>)}
  </div>
</article>

<style is:global>
  .chart-line {
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    animation: draw 2.2s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>
