---
interface Props {
  title?: string;
  subtitle?: string;
  seriesA?: number[];
  seriesB?: number[];
  labels?: string[];
  height?: number;
  class?: string;
}
const {
  title = 'Revenue',
  subtitle = 'Last 14 days · all venues',
  seriesA = [42, 48, 45, 54, 62, 58, 66, 71, 68, 74, 81, 78, 86, 92],
  seriesB = [38, 40, 43, 45, 50, 48, 55, 58, 56, 60, 65, 62, 68, 72],
  labels = ['M','T','W','T','F','S','S','M','T','W','T','F','S','S'],
  height = 220,
  class: className = '',
} = Astro.props;

const buildPath = (data: number[]): { line: string; area: string } => {
  const max = Math.max(...data, ...seriesB);
  const min = Math.min(...data, ...seriesB);
  const range = max - min || 1;
  const w = 600, h = height - 40;
  const points = data.map((v, i) => {
    const x = (i / (data.length - 1)) * w;
    const y = h - ((v - min) / range) * h + 20;
    return [x, y] as [number, number];
  });
  const line = points.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
  const area = `${line} L${w},${h + 20} L0,${h + 20} Z`;
  return { line, area };
};

const a = buildPath(seriesA);
const b = buildPath(seriesB);
const w = 600;
const h = height;
---
<div class={`relative border border-ink/10 bg-paper p-6 ${className}`}>
  <div class="flex items-start justify-between">
    <div>
      <div class="eyebrow text-ink-500">{title}</div>
      <div class="mt-1 text-sm text-ink-500">{subtitle}</div>
    </div>
    <div class="flex items-center gap-4 text-[0.72rem] text-ink-500">
      <span class="flex items-center gap-2"><span class="h-0.5 w-4 bg-brass-500"></span>This period</span>
      <span class="flex items-center gap-2"><span class="h-0.5 w-4 bg-ink-300"></span>Prior</span>
    </div>
  </div>

  <svg viewBox={`0 0 ${w} ${h}`} class="mt-6 h-auto w-full" preserveAspectRatio="none" role="img" aria-label={`${title} trend chart`}>
    <!-- grid -->
    {[0, 1, 2, 3, 4].map((i) => (
      <line x1="0" x2={w} y1={20 + i * ((h - 40) / 4)} y2={20 + i * ((h - 40) / 4)} stroke="rgb(10 10 10 / 0.06)" stroke-width="0.5"/>
    ))}

    <defs>
      <linearGradient id="areaA" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#B8935A" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#B8935A" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <path d={b.line} fill="none" stroke="#B8B0A2" stroke-width="1" stroke-dasharray="3 3"/>
    <path d={a.area} fill="url(#areaA)"/>
    <path d={a.line} fill="none" stroke="#B8935A" stroke-width="1.5"/>

    {seriesA.map((v, i) => {
      const x = (i / (seriesA.length - 1)) * w;
      const max = Math.max(...seriesA, ...seriesB);
      const min = Math.min(...seriesA, ...seriesB);
      const range = max - min || 1;
      const y = (h - 40) - ((v - min) / range) * (h - 40) + 20;
      return <circle cx={x} cy={y} r="2" fill="#FAFAF7" stroke="#B8935A" stroke-width="1.25"/>;
    })}
  </svg>

  <div class="mt-3 flex justify-between text-[0.65rem] text-ink-400">
    {labels.map((l) => <span class="mono">{l}</span>)}
  </div>
</div>
