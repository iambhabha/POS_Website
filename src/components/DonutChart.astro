---
interface Props {
  title?: string;
  segments?: { label: string; value: number; color: string }[];
}
const {
  title = "Revenue mix",
  segments = [
    { label: "Dining", value: 46, color: "#334155" },
    { label: "Bar", value: 28, color: "#475569" },
    { label: "Rooms", value: 18, color: "#64748b" },
    { label: "Events", value: 8, color: "#94a3b8" },
  ],
} = Astro.props;

const R = 48;
const C = 2 * Math.PI * R;
let offset = 0;
const dashes = segments.map((s) => {
  const len = (s.value / 100) * C;
  const entry = { ...s, len, offset };
  offset += len;
  return entry;
});
---
<article class="reveal rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] p-6 shadow-sm">
  <p class="text-sm font-semibold">{title}</p>
  <p class="text-xs text-[var(--text-muted)]">This week</p>

  <div class="mt-4 flex items-center gap-6">
    <svg viewBox="0 0 120 120" class="h-36 w-36 -rotate-90">
      <circle cx="60" cy="60" r={R} fill="none" stroke="currentColor" stroke-opacity="0.08" stroke-width="14" />
      {dashes.map((d) => (
        <circle
          cx="60" cy="60" r={R}
          fill="none" stroke={d.color} stroke-width="14" stroke-linecap="butt"
          stroke-dasharray={`${d.len} ${C - d.len}`}
          stroke-dashoffset={-d.offset}
        />
      ))}
    </svg>
    <ul class="flex-1 space-y-2 text-sm">
      {segments.map((s) => (
        <li class="flex items-center justify-between">
          <span class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full" style={`background:${s.color}`}></span>
            {s.label}
          </span>
          <span class="text-[var(--text-muted)]">{s.value}%</span>
        </li>
      ))}
    </ul>
  </div>
</article>
