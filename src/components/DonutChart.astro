---
interface Props {
  title?: string;
  segments?: { label: string; value: number; color?: string }[];
  total?: string;
  totalLabel?: string;
  class?: string;
}
const {
  title = 'Revenue mix',
  segments = [
    { label: 'Food',      value: 46, color: '#0A0A0A' },
    { label: 'Beverage',  value: 28, color: '#B8935A' },
    { label: 'Rooms',     value: 18, color: '#615A4E' },
    { label: 'Events',    value: 8,  color: '#D4B77A' },
  ],
  total = '€386k',
  totalLabel = 'This month',
  class: className = '',
} = Astro.props;

const sum = segments.reduce((s, x) => s + x.value, 0);
const R = 70, C = 2 * Math.PI * R;

let offset = 0;
const arcs = segments.map((seg) => {
  const frac = seg.value / sum;
  const len = frac * C;
  const node = { ...seg, len, off: offset };
  offset += len;
  return node;
});
---
<div class={`border border-ink/10 bg-paper p-6 ${className}`}>
  <div class="eyebrow text-ink-500">{title}</div>

  <div class="mt-4 grid grid-cols-[auto_1fr] items-center gap-6">
    <svg viewBox="0 0 180 180" class="h-36 w-36 -rotate-90">
      <circle cx="90" cy="90" r={R} fill="none" stroke="rgb(10 10 10 / 0.06)" stroke-width="14"/>
      {arcs.map((a) => (
        <circle
          cx="90" cy="90" r={R}
          fill="none"
          stroke={a.color}
          stroke-width="14"
          stroke-dasharray={`${a.len} ${C - a.len}`}
          stroke-dashoffset={-a.off}
          stroke-linecap="butt"
        />
      ))}
      <g transform="rotate(90 90 90)">
        <text x="90" y="86" text-anchor="middle" class="num fill-ink" font-size="22" font-family="Fraunces Variable">{total}</text>
        <text x="90" y="104" text-anchor="middle" class="fill-ink-500" font-size="9" letter-spacing="1.5">{totalLabel.toUpperCase()}</text>
      </g>
    </svg>

    <ul class="space-y-2.5 text-[0.82rem]">
      {arcs.map((a) => (
        <li class="flex items-center gap-3">
          <span class="inline-block h-2.5 w-2.5" style={`background:${a.color}`}></span>
          <span class="text-ink">{a.label}</span>
          <span class="mono ml-auto text-ink-500">{Math.round((a.value / sum) * 100)}%</span>
        </li>
      ))}
    </ul>
  </div>
</div>
