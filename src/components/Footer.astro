---
import Logo from './Logo.astro';

const cols = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/features' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Download', href: '/download' },
      { label: 'Dashboard', href: '/dashboard' },
    ],
  },
  {
    title: 'Venues',
    links: [
      { label: 'Restaurants', href: '/features#restaurants' },
      { label: 'Bars & cocktails', href: '/features#bars' },
      { label: 'Hotels', href: '/features#hotels' },
      { label: 'Multi-location', href: '/features#groups' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Contact', href: '/contact' },
      { label: 'Careers', href: '/contact#careers' },
      { label: 'Press', href: '/contact#press' },
      { label: 'Changelog', href: '#' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '#' },
      { label: 'Terms', href: '#' },
      { label: 'DPA', href: '#' },
      { label: 'Security', href: '#' },
    ],
  },
];
---
<footer class="relative overflow-hidden">
  <div class="seam-warm-top absolute inset-x-0 top-0 h-40"></div>
  <div class="relative bg-paper-warm">
    <div class="container-edge grid gap-16 py-22 lg:grid-cols-[1.2fr_3fr]">
      <div>
        <Logo />
        <p class="mt-6 max-w-sm text-[0.95rem] leading-relaxed text-ink-500">
          The operating system for bars, hotels, and restaurants that treat hospitality
          as a craft. Made, not generated.
        </p>
        <div class="mt-8 flex items-center gap-3">
          <a href="#" aria-label="Twitter" class="inline-flex h-9 w-9 items-center justify-center border border-ink/15 transition-colors hover:border-ink hover:bg-ink hover:text-paper">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor"><path d="M12.7 1.5h2.3l-5 5.7 5.9 7.8H11.3L7.6 9.8 3.4 15h-2.3l5.3-6.1L.8 1.5h4.6l3.3 4.4 3.9-4.4Z"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="inline-flex h-9 w-9 items-center justify-center border border-ink/15 transition-colors hover:border-ink hover:bg-ink hover:text-paper">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor"><path d="M2.5 2.5a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8ZM1.3 6h2.4v8H1.3V6Zm4 0h2.3v1.1h.04C7.94 6.4 8.9 5.8 10.2 5.8c2.5 0 3 1.7 3 3.9V14h-2.4V10c0-1 0-2.3-1.4-2.3-1.4 0-1.6 1.1-1.6 2.2V14H5.3V6Z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="inline-flex h-9 w-9 items-center justify-center border border-ink/15 transition-colors hover:border-ink hover:bg-ink hover:text-paper">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="12" height="12" rx="3"/><circle cx="8" cy="8" r="2.7"/><circle cx="11.6" cy="4.4" r=".7" fill="currentColor"/></svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-4">
        {cols.map((c) => (
          <div>
            <div class="eyebrow mb-5 text-ink-500">{c.title}</div>
            <ul class="space-y-3">
              {c.links.map((l) => (
                <li><a href={l.href} class="text-sm text-ink-700 transition-colors hover:text-ink">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="border-t border-ink/10">
      <div class="container-edge flex flex-col items-start justify-between gap-4 py-8 text-xs text-ink-500 sm:flex-row sm:items-center">
        <div class="flex items-center gap-2">
          <span>© {new Date().getFullYear()} Maison Hospitality Systems</span>
          <span class="hidden sm:inline">·</span>
          <span class="hidden sm:inline">Crafted in Copenhagen & Singapore</span>
        </div>
        <div class="flex items-center gap-5">
          <span class="flex items-center gap-2">
            <span class="relative inline-flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-60"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-green-600"></span>
            </span>
            All systems operational
          </span>
          <span>v4.2 · Artemis</span>
        </div>
      </div>
    </div>
  </div>
</footer>
