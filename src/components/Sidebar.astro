---
import Logo from './Logo.astro';

interface Props {
  current?: string;
}
const { current = 'overview' } = Astro.props;

const groups = [
  {
    label: 'Service',
    items: [
      { id: 'overview',    label: 'Overview',     icon: 'M3 12h18M3 6h18M3 18h18' },
      { id: 'floor',       label: 'Floor plan',   icon: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z' },
      { id: 'orders',      label: 'Orders',       icon: 'M6 4h12v16H6zM9 8h6M9 12h6M9 16h3' },
      { id: 'reservations',label: 'Reservations', icon: 'M3 6h18v14H3zM3 10h18M8 3v4M16 3v4' },
    ],
  },
  {
    label: 'Operations',
    items: [
      { id: 'inventory', label: 'Inventory',  icon: 'M4 7l8-4 8 4v10l-8 4-8-4zM4 7l8 4 8-4M12 11v10' },
      { id: 'menu',      label: 'Menu',       icon: 'M6 3v18M18 3v18M10 7h4M10 12h4M10 17h4' },
      { id: 'staff',     label: 'Staff',      icon: 'M8 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20a6 6 0 0 1 12 0M16 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM14 14a4 4 0 0 1 8 3' },
      { id: 'rooms',     label: 'Rooms',      icon: 'M3 10l9-6 9 6v10H3zM9 20v-6h6v6' },
    ],
  },
  {
    label: 'Growth',
    items: [
      { id: 'guests',    label: 'Guest memory', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 20a8 8 0 0 1 16 0' },
      { id: 'insights',  label: 'Insights',     icon: 'M4 20V9M10 20V4M16 20v-7' },
      { id: 'marketing', label: 'Marketing',    icon: 'M3 11v2a4 4 0 0 0 4 4h1l3 3V7L8 10H7a4 4 0 0 0-4 4M14 8l6-4v16l-6-4' },
    ],
  },
];
---
<aside class="hidden w-64 shrink-0 border-r border-ink/10 bg-paper-warm/40 lg:flex lg:flex-col">
  <div class="flex h-16 items-center border-b border-ink/10 px-5">
    <Logo />
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-5 no-scrollbar">
    {groups.map((g) => (
      <div class="mb-6">
        <div class="eyebrow px-2 pb-2 text-ink-400">{g.label}</div>
        <ul class="space-y-0.5">
          {g.items.map((it) => {
            const active = current === it.id;
            return (
              <li>
                <a href={`#${it.id}`}
                   class={`group relative flex items-center gap-3 px-2.5 py-2 text-sm transition-colors ${
                     active ? 'bg-ink text-paper' : 'text-ink-600 hover:bg-ink/5 hover:text-ink'
                   }`}>
                  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d={it.icon} stroke-linecap="square" stroke-linejoin="miter"/>
                  </svg>
                  <span class="truncate">{it.label}</span>
                  {active && <span class="ml-auto mono text-[0.6rem] text-brass-300">⌘{g.items.indexOf(it) + 1}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>

  <div class="border-t border-ink/10 p-4">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center bg-ink font-display text-sm text-paper">L</div>
      <div class="min-w-0 leading-tight">
        <div class="truncate text-sm text-ink">Léo Desjardins</div>
        <div class="mono text-[0.68rem] text-ink-500">Kenzo House · Manager</div>
      </div>
      <button class="ml-auto text-ink-400 hover:text-ink" aria-label="Account menu">
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="4" r="1"/><circle cx="8" cy="8" r="1"/><circle cx="8" cy="12" r="1"/></svg>
      </button>
    </div>
  </div>
</aside>
