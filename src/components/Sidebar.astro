---
import Logo from "./Logo.astro";

interface Props {
  items: { href: string; label: string; icon: string; badge?: string }[];
  footer?: { name: string; role: string };
}
const { items, footer } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<aside class="sticky top-4 z-30 hidden h-[calc(100vh-2rem)] w-64 flex-none md:block">
  <div class="flex h-full flex-col rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] p-4 shadow-sm">
    <div class="px-2 pt-2">
      <Logo />
    </div>
    <nav class="mt-6 flex-1 space-y-1">
      {items.map((item) => {
        const active = pathname === item.href || pathname.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            class:list={[
              "relative flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors",
              active
                ? "border border-[var(--surface-border)] bg-[var(--bg-soft)] text-[var(--text)]"
                : "text-[var(--text-muted)] hover:bg-[var(--bg-soft)] hover:text-[var(--text)]",
            ]}
          >
            <span class:list={[
              "grid h-8 w-8 place-items-center rounded-lg border border-[var(--surface-border)]",
              active ? "bg-[var(--surface)]" : "bg-[var(--bg)]"
            ]}>
              <Fragment set:html={item.icon} />
            </span>
            <span class="flex-1">{item.label}</span>
            {item.badge && (
              <span class="rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-2 py-0.5 text-[10px] font-semibold text-[var(--text-muted)]">{item.badge}</span>
            )}
          </a>
        );
      })}
    </nav>
    {footer && (
      <div class="mt-4 rounded-xl border border-[var(--surface-border)] bg-[var(--bg-soft)] p-3">
        <div class="flex items-center gap-3">
          <span class="h-10 w-10 rounded-lg border border-[var(--surface-border)] bg-[var(--surface)]"></span>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold">{footer.name}</p>
            <p class="truncate text-xs text-[var(--text-muted)]">{footer.role}</p>
          </div>
        </div>
      </div>
    )}
  </div>
</aside>
