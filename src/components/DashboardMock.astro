---
import StatCard from './StatCard.astro';
import LineChart from './LineChart.astro';
import DonutChart from './DonutChart.astro';
---
<div class="relative overflow-hidden border border-ink/10 bg-paper">
  <!-- Chrome -->
  <div class="flex items-center justify-between border-b border-ink/10 bg-paper-warm/50 px-5 py-3">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-ink/15"></span>
      <span class="inline-block h-2 w-2 rounded-full bg-ink/15"></span>
      <span class="inline-block h-2 w-2 rounded-full bg-ink/15"></span>
    </div>
    <div class="mono text-[0.68rem] tracking-wide text-ink-500">maison.app / service</div>
    <div class="flex items-center gap-1.5 mono text-[0.6rem] text-ink-400">
      <span class="inline-flex h-1.5 w-1.5 rounded-full bg-green-500"></span>
      LIVE · 12:42
    </div>
  </div>

  <div class="grid gap-4 p-5 md:grid-cols-3">
    <StatCard label="Revenue today" value="€14,682" delta="+8.4%" trend="up" hint="vs. last Friday" sparkline={[8,9,12,11,14,16,18,21,19,24,22,26,28,32]} />
    <StatCard label="Covers" value="142" delta="+12" trend="up" hint="18:00 seating active" />
    <StatCard label="Avg check" value="€103" delta="−2%" trend="down" hint="Pairing down-trade" />
  </div>

  <div class="grid gap-4 px-5 pb-5 lg:grid-cols-[1.6fr_1fr]">
    <LineChart />
    <DonutChart />
  </div>

  <div class="border-t border-ink/10 px-5 py-4">
    <div class="flex items-center justify-between">
      <div class="eyebrow text-ink-500">Tonight's service</div>
      <div class="mono text-[0.62rem] text-ink-400">28 of 32 tables · 12 walks-in expected</div>
    </div>
    <div class="mt-3 grid grid-cols-4 gap-1 sm:grid-cols-8 md:grid-cols-12">
      {Array.from({ length: 24 }).map((_, i) => {
        const s = [0.9, 0.6, 0.3, 0.05][i % 4];
        const state = s > 0.7 ? 'bg-ink' : s > 0.4 ? 'bg-brass-500' : s > 0.2 ? 'bg-brass-200' : 'border border-ink/10';
        return <div class={`aspect-square ${state}`}></div>;
      })}
    </div>
  </div>
</div>
