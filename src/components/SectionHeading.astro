---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
}
const { eyebrow, title, subtitle, align = "center" } = Astro.props;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---
<div class={`max-w-3xl ${alignClass}`}>
  {eyebrow && <span class="chip mb-4"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>{eyebrow}</span>}
  <h2 class="text-3xl font-semibold tracking-tight md:text-5xl" set:html={title} />
  {subtitle && <p class="mt-4 text-base text-[var(--text-muted)] md:text-lg">{subtitle}</p>}
</div>
