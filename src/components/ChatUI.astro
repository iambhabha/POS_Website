---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const messages = [
  { who: 'guest', name: 'Clara Abate', role: 'VIP · allergic to walnuts', time: '19:22', text: 'Running 10 min late — can we keep the back booth?' },
  { who: 'staff', name: 'Léo · Maître d\'', time: '19:23', text: 'Of course, Clara. Booth 7 is held. Still pét-nat to start?' },
  { who: 'guest', name: 'Clara Abate', time: '19:24', text: 'Please. And a vegetarian for the 4th guest.' },
  { who: 'ai', name: 'Service AI', time: '19:24', text: 'Suggested: swap uni linguine → girolle risotto for guest 4. Allergy flag active (walnuts). Shall I notify the kitchen?' },
  { who: 'staff', name: 'Léo · Maître d\'', time: '19:25', text: '✓ Sent.' },
];
---
<div class={`overflow-hidden border border-ink/10 bg-paper ${className}`}>
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-ink/10 bg-paper-warm/50 px-5 py-3">
    <div class="flex items-center gap-3">
      <div class="flex h-8 w-8 items-center justify-center bg-ink font-display text-sm text-paper">C</div>
      <div class="leading-tight">
        <div class="text-sm text-ink">Clara Abate</div>
        <div class="mono text-[0.68rem] text-ink-500">Reservation · 19:30 · 4 pax</div>
      </div>
    </div>
    <div class="flex items-center gap-2 text-[0.68rem] text-ink-500">
      <span class="chip bg-paper">Guest memory · 14 visits</span>
    </div>
  </div>

  <!-- Thread -->
  <div class="space-y-5 p-5">
    {messages.map((m) => {
      const isStaff = m.who === 'staff';
      const isAI = m.who === 'ai';
      return (
        <div class={`flex gap-3 ${isStaff ? 'flex-row-reverse text-right' : ''}`}>
          <div class={`flex h-7 w-7 shrink-0 items-center justify-center text-[0.65rem] ${
            isStaff ? 'bg-ink text-paper' :
            isAI ? 'border border-brass-500 text-brass-700' :
            'border border-ink/20 text-ink'
          }`}>
            {isAI ? '✦' : m.name.charAt(0)}
          </div>
          <div class={`max-w-[78%] ${isStaff ? 'items-end' : ''}`}>
            <div class="flex items-center gap-2 text-[0.66rem] text-ink-500">
              <span>{m.name}</span>
              <span class="mono">{m.time}</span>
            </div>
            <div class={`mt-1 inline-block px-3.5 py-2.5 text-[0.82rem] leading-relaxed ${
              isStaff ? 'bg-ink text-paper' :
              isAI ? 'border border-brass-400 bg-brass-50 text-ink' :
              'border border-ink/10 bg-paper-warm text-ink'
            }`}>
              {m.text}
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Composer -->
  <div class="flex items-center gap-3 border-t border-ink/10 bg-paper-warm/40 px-5 py-3">
    <input type="text" placeholder="Reply to Clara…" class="flex-1 bg-transparent text-sm text-ink placeholder:text-ink-400 focus:outline-none" />
    <span class="mono text-[0.62rem] text-ink-400">⌘↵</span>
    <button class="btn-primary px-3 py-1.5 text-xs">Send</button>
  </div>
</div>
