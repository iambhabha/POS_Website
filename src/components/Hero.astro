---
import ParallaxLayer from './ParallaxLayer.astro';
---
<section class="relative isolate overflow-hidden pt-32 sm:pt-36 lg:pt-44 pb-32 lg:pb-44">
  <!-- Parallax atmosphere -->
  <div class="hero-aurora absolute inset-0 -z-10"></div>
  <div class="grain absolute inset-0 -z-10 opacity-60"></div>

  <ParallaxLayer speed={-0.12} class="pointer-events-none absolute -top-20 -left-20 h-[420px] w-[420px] -z-10">
    <div class="h-full w-full rounded-full bg-brass-200/50 blur-3xl"></div>
  </ParallaxLayer>
  <ParallaxLayer speed={0.08} class="pointer-events-none absolute -right-32 top-40 h-[520px] w-[520px] -z-10">
    <div class="h-full w-full rounded-full bg-paper-cream blur-3xl"></div>
  </ParallaxLayer>

  <!-- Subtle grid -->
  <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-[0.07]" aria-hidden="true">
    <defs>
      <pattern id="grid" width="72" height="72" patternUnits="userSpaceOnUse">
        <path d="M72 0H0v72" fill="none" stroke="currentColor" stroke-width="0.5"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid)" class="text-ink"/>
  </svg>

  <div class="container-edge relative">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <!-- Copy -->
      <div class="relative">
        <div data-reveal class="chip mb-7 bg-paper/70 backdrop-blur">
          <span class="relative inline-flex h-1.5 w-1.5">
            <span class="absolute h-full w-full animate-ping rounded-full bg-brass-400"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-brass-500"></span>
          </span>
          New — Service AI & inventory forecasting
        </div>

        <h1 data-reveal style="transition-delay:60ms"
            class="font-display text-[3.25rem] leading-[0.96] tracking-tightest text-ink sm:text-[4.5rem] lg:text-[5.5rem]">
          Hospitality, <em class="not-italic italic-serif"><span class="underline-brass">run</span></em><br/>
          with the<br/>
          <span class="text-ink-500">grain of</span> <span>craft.</span>
        </h1>

        <p data-reveal style="transition-delay:180ms"
           class="mt-8 max-w-xl text-[1.08rem] leading-relaxed text-ink-500">
          One elegant system for your bar, hotel, and restaurant — POS, reservations,
          inventory, staff, and guest memory. Fewer tabs, better service, higher margins.
        </p>

        <div data-reveal style="transition-delay:260ms" class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/download" class="btn-primary group">
            <span>Start 30-day trial</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 7h12M8 2l5 5-5 5" stroke-linecap="square"/></svg>
          </a>
          <a href="/features" class="btn-ghost group">
            <span>See the craft</span>
            <span class="text-brass-600">→</span>
          </a>
        </div>

        <!-- Trust strip -->
        <div data-reveal style="transition-delay:360ms" class="mt-14">
          <div class="eyebrow mb-4 flex items-center gap-3">
            <span class="h-px w-6 bg-ink-400"></span>
            Trusted at 1,800+ venues in 34 countries
          </div>
          <div class="flex flex-wrap items-center gap-x-10 gap-y-4 opacity-75">
            {['Kenzo House','Aurum Bar','Maison Rive','Hotel Kōya','La Finca','Brunswick'].map((b) => (
              <span class="font-display text-[0.95rem] tracking-tight text-ink-600">{b}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Floating product preview -->
      <div class="relative">
        <ParallaxLayer speed={-0.06} class="relative">
          <div data-reveal="scale" class="relative animate-float-slow">
            <!-- Shadow frame -->
            <div class="absolute -inset-4 -z-10 bg-paper-warm/70 blur-2xl"></div>

            <!-- Main card -->
            <div class="relative border border-ink/10 bg-paper">
              <!-- Window chrome -->
              <div class="flex items-center justify-between border-b border-ink/10 bg-paper-warm/60 px-4 py-2.5">
                <div class="flex items-center gap-1.5">
                  <span class="inline-block h-2 w-2 rounded-full bg-ink/15"></span>
                  <span class="inline-block h-2 w-2 rounded-full bg-ink/15"></span>
                  <span class="inline-block h-2 w-2 rounded-full bg-ink/15"></span>
                </div>
                <div class="flex items-center gap-2 text-[0.68rem] tracking-wide text-ink-500">
                  <span class="mono">maison · kenzo house</span>
                </div>
                <div class="flex items-center gap-1 text-ink-400">
                  <span class="inline-flex h-1.5 w-1.5 rounded-full bg-green-500"></span>
                  <span class="mono text-[0.62rem]">LIVE</span>
                </div>
              </div>

              <!-- Body -->
              <div class="grid grid-cols-[1fr_1.4fr] gap-0">
                <!-- Sidebar preview -->
                <div class="border-r border-ink/10 bg-paper-warm/40 p-5">
                  <div class="eyebrow mb-3 text-ink-400">Service</div>
                  <div class="space-y-1.5 text-[0.78rem]">
                    <div class="flex items-center justify-between bg-ink/5 px-2.5 py-1.5">
                      <span class="text-ink">Floor</span>
                      <span class="mono text-ink-500">28/32</span>
                    </div>
                    <div class="flex items-center justify-between px-2.5 py-1.5 text-ink-500">
                      <span>Bar</span><span class="mono">12</span>
                    </div>
                    <div class="flex items-center justify-between px-2.5 py-1.5 text-ink-500">
                      <span>Terrace</span><span class="mono">8</span>
                    </div>
                    <div class="flex items-center justify-between px-2.5 py-1.5 text-ink-500">
                      <span>Private</span><span class="mono">—</span>
                    </div>
                  </div>

                  <div class="eyebrow mb-3 mt-6 text-ink-400">Tonight</div>
                  <div class="space-y-2 text-[0.72rem]">
                    <div class="flex items-center gap-2">
                      <span class="mono text-ink-500">19:30</span>
                      <span class="text-ink">Abate ×4</span>
                      <span class="ml-auto h-1.5 w-1.5 rounded-full bg-brass-500"></span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="mono text-ink-500">20:00</span>
                      <span class="text-ink">Volkov ×2</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="mono text-ink-500">20:45</span>
                      <span class="text-ink">Ishikawa ×6</span>
                    </div>
                  </div>
                </div>

                <!-- Main panel -->
                <div class="p-5">
                  <div class="flex items-baseline justify-between">
                    <div>
                      <div class="eyebrow text-ink-400">Revenue · today</div>
                      <div class="num mt-1 text-[2.2rem] leading-none tracking-tightest text-ink">€14,682</div>
                    </div>
                    <div class="text-right text-[0.7rem]">
                      <div class="mono text-brass-600">+ 8.4%</div>
                      <div class="text-ink-400">vs. last Fri</div>
                    </div>
                  </div>

                  <!-- Mini chart -->
                  <svg viewBox="0 0 240 80" class="mt-4 h-20 w-full" fill="none" stroke-linecap="round">
                    <defs>
                      <linearGradient id="heroLine" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="#B8935A" stop-opacity="0.35"/>
                        <stop offset="100%" stop-color="#B8935A" stop-opacity="0"/>
                      </linearGradient>
                    </defs>
                    <path d="M0,60 L20,52 L40,56 L60,46 L80,40 L100,44 L120,30 L140,32 L160,24 L180,28 L200,18 L220,22 L240,14 L240,80 L0,80 Z" fill="url(#heroLine)"/>
                    <path d="M0,60 L20,52 L40,56 L60,46 L80,40 L100,44 L120,30 L140,32 L160,24 L180,28 L200,18 L220,22 L240,14" stroke="#B8935A" stroke-width="1.5"/>
                  </svg>

                  <div class="mt-4 grid grid-cols-3 gap-3 text-[0.72rem]">
                    <div class="border-t border-ink/10 pt-2">
                      <div class="text-ink-400">Covers</div>
                      <div class="num mt-0.5 text-lg text-ink">142</div>
                    </div>
                    <div class="border-t border-ink/10 pt-2">
                      <div class="text-ink-400">Avg check</div>
                      <div class="num mt-0.5 text-lg text-ink">€103</div>
                    </div>
                    <div class="border-t border-ink/10 pt-2">
                      <div class="text-ink-400">Margin</div>
                      <div class="num mt-0.5 text-lg text-ink">71%</div>
                    </div>
                  </div>

                  <!-- Live orders -->
                  <div class="mt-5 border-t border-ink/10 pt-4">
                    <div class="eyebrow mb-2 text-ink-400">Live orders</div>
                    <div class="space-y-1.5">
                      <div class="flex items-center gap-3 text-[0.76rem]">
                        <span class="mono w-10 text-ink-400">T-07</span>
                        <span class="text-ink">Uni linguine · Pét-nat</span>
                        <span class="mono ml-auto text-brass-600">12m</span>
                      </div>
                      <div class="flex items-center gap-3 text-[0.76rem]">
                        <span class="mono w-10 text-ink-400">T-12</span>
                        <span class="text-ink">Smoked duck · Negroni</span>
                        <span class="mono ml-auto text-ink-400">4m</span>
                      </div>
                      <div class="flex items-center gap-3 text-[0.76rem]">
                        <span class="mono w-10 text-ink-400">B-03</span>
                        <span class="text-ink">Martini ×2, Espresso</span>
                        <span class="mono ml-auto text-ink-400">1m</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </ParallaxLayer>

        <!-- Floating reservation card -->
        <ParallaxLayer speed={0.18} class="absolute -bottom-10 -left-6 z-10 hidden sm:block">
          <div data-reveal="left" style="transition-delay:480ms"
               class="w-64 animate-float border border-ink/10 bg-paper/95 p-4 backdrop-blur">
            <div class="flex items-center gap-2">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brass-100 font-display text-sm text-brass-700">A</div>
              <div class="leading-tight">
                <div class="text-[0.78rem] text-ink">New reservation</div>
                <div class="mono text-[0.65rem] text-ink-500">Abate · 4 pax · 19:30</div>
              </div>
            </div>
            <div class="mt-3 text-[0.72rem] text-ink-500">
              Guest memory: <span class="text-ink">allergic to walnuts, prefers back booth</span>
            </div>
          </div>
        </ParallaxLayer>

        <!-- Floating stock alert -->
        <ParallaxLayer speed={-0.22} class="absolute -right-4 -top-6 hidden sm:block">
          <div data-reveal="right" style="transition-delay:560ms"
               class="w-56 border border-ink/10 bg-ink p-4 text-paper">
            <div class="eyebrow text-brass-300">Inventory</div>
            <div class="mt-1 text-sm">Chablis '22 — 6 left</div>
            <div class="mono mt-2 text-[0.68rem] text-paper/60">Reorder by 18:00</div>
            <div class="mt-2 h-1 w-full bg-paper/10">
              <div class="h-full w-1/6 bg-brass-400"></div>
            </div>
          </div>
        </ParallaxLayer>
      </div>
    </div>
  </div>

  <!-- Seam into next section -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-paper"></div>
</section>

<style>
  .italic-serif { font-style: italic; font-variation-settings: 'opsz' 144, 'SOFT' 100; }
</style>
