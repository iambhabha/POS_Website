---
interface Props {
  label: string;
  value: string;
  delta?: string;
  trend?: 'up' | 'down' | 'flat';
  hint?: string;
  sparkline?: number[];
  tone?: 'paper' | 'ink';
  class?: string;
}
const {
  label, value, delta, trend = 'up', hint, sparkline, tone = 'paper', class: className = '',
} = Astro.props;

const trendColor =
  trend === 'up' ? 'text-brass-600' :
  trend === 'down' ? 'text-red-600' :
  'text-ink-400';

const arrow = trend === 'up' ? '↗' : trend === 'down' ? '↘' : '→';

let path = '';
if (sparkline && sparkline.length > 1) {
  const max = Math.max(...sparkline);
  const min = Math.min(...sparkline);
  const range = max - min || 1;
  const w = 100, h = 32;
  path = sparkline.map((v, i) => {
    const x = (i / (sparkline.length - 1)) * w;
    const y = h - ((v - min) / range) * h;
    return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
}

const base = tone === 'ink'
  ? 'bg-ink text-paper border-ink/20'
  : 'bg-paper text-ink border-ink/10';
---
<div class={`relative overflow-hidden border p-6 ${base} ${className}`}>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class={`eyebrow ${tone === 'ink' ? 'text-paper/50' : 'text-ink-500'}`}>{label}</div>
      <div class="num mt-3 text-3xl leading-none tracking-tightest">{value}</div>
      {hint && <div class={`mt-2 text-[0.72rem] ${tone === 'ink' ? 'text-paper/50' : 'text-ink-400'}`}>{hint}</div>}
    </div>
    {delta && (
      <div class={`mono text-[0.75rem] ${trendColor}`}>
        {arrow} {delta}
      </div>
    )}
  </div>

  {path && (
    <svg viewBox="0 0 100 32" preserveAspectRatio="none" class="mt-4 h-10 w-full" fill="none">
      <path d={path} stroke="currentColor" class={trend === 'up' ? 'text-brass-500' : 'text-ink-400'} stroke-width="1.25"/>
    </svg>
  )}
</div>
