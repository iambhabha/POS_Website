---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  section?: string;
  venue?: string;
  current?: string;
}
const { title, section = 'Service', venue = 'Kenzo House · Copenhagen', current = 'overview' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('theme') ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (t === 'dark') document.documentElement.classList.add('dark');
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="flex min-h-dvh">
      <Sidebar current={current} />

      <div class="flex min-w-0 flex-1 flex-col">
        <!-- Top bar -->
        <header class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-ink/10 bg-paper/80 px-6 backdrop-blur">
          <div class="flex items-center gap-3">
            <div class="hidden text-[0.68rem] text-ink-400 mono sm:block">MAISON / {section.toUpperCase()}</div>
            <div class="hidden h-4 w-px bg-ink/15 sm:block"></div>
            <div class="text-sm text-ink">{venue}</div>
          </div>

          <div class="flex items-center gap-2">
            <div class="hidden items-center gap-2 border border-ink/15 px-3 py-1.5 text-xs text-ink-500 md:flex">
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4"/><path d="M10 10l3 3" stroke-linecap="square"/></svg>
              <span>Search orders, guests, menu…</span>
              <span class="mono text-[0.62rem] text-ink-400">⌘K</span>
            </div>
            <ThemeToggle />
            <button class="inline-flex h-9 w-9 items-center justify-center border border-ink/15 text-ink-500 transition-colors hover:border-ink hover:text-ink" aria-label="Notifications">
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6a4 4 0 1 1 8 0v3l1.5 2h-11L4 9V6zM6.5 13a1.5 1.5 0 0 0 3 0" stroke-linecap="square"/></svg>
            </button>
            <a href="/" class="inline-flex h-9 items-center border border-ink/15 px-3 text-xs text-ink-600 transition-colors hover:border-ink hover:text-ink">Exit</a>
          </div>
        </header>

        <main class="flex-1 overflow-x-hidden">
          <slot />
        </main>
      </div>
    </div>

    <script>
      // Reveal on scroll within dashboard
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
