---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureCard from "../components/FeatureCard.astro";
import DashboardMock from "../components/DashboardMock.astro";

const categories = [
  {
    title: "Billing and counter operations",
    items: [
      { t: "Fast POS billing", d: "Create KOT, split bill, merge tables, partial settlement and fast checkout in peak hours." },
      { t: "Multiple payment modes", d: "Cash, card, UPI and mixed settlement with operator-level tracking and shift summary." },
      { t: "Role-based control", d: "Owner, manager, cashier and waiter permissions for secure production environment." },
    ],
  },
  {
    title: "Restaurant and kitchen control",
    items: [
      { t: "Kitchen display", d: "Station-wise live KOT, prep queue and status updates for faster service turnaround." },
      { t: "Inventory tracking", d: "Raw stock in, stock out, low alerts and item cost visibility for margin control." },
      { t: "Menu management", d: "Item groups, modifiers, combo setup and price updates across all counters quickly." },
    ],
  },
  {
    title: "Hotel and property workflows",
    items: [
      { t: "Front desk", d: "Room assignment, check-in/out, service posting and invoice in one connected workflow." },
      { t: "Housekeeping", d: "Room cleaning status, issue notes and turnaround visibility for every floor." },
      { t: "Revenue reports", d: "Date-wise occupancy, room revenue, food revenue and total business snapshots." },
    ],
  },
];

const compare = [
  { label: "Cloud subscription plan", a: true, b: false, c: false },
  { label: "Windows EXE local license", a: true, b: false, c: false },
  { label: "Android phone app license", a: true, b: false, c: false },
  { label: "Works in low/no internet", a: true, b: false, c: false },
  { label: "Bar + restaurant + hotel in one", a: true, b: false, c: false },
  { label: "Payment page with clear breakup", a: true, b: false, c: false },
  { label: "Onboarding and setup guidance", a: true, b: false, c: false },
];
---

<BaseLayout title="Features — Atithya Production Suite">
  <section class="relative px-5 pt-20">
    <div class="mx-auto max-w-5xl text-center">
      <span class="chip reveal">Features</span>
      <h1 class="reveal mt-4 text-5xl font-semibold tracking-tight md:text-7xl" style="transition-delay:80ms;">
        Modules that actually run
        <span class="gradient-text animate-gradient">daily production business.</span>
      </h1>
      <p class="reveal mx-auto mt-6 max-w-2xl text-[var(--text-muted)] md:text-lg" style="transition-delay:160ms;">
        Atithya is built to sell and operate your business. From billing to room checkout, every module is practical, connected and ready for real rush hours.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-5xl">
      <div class="card-3d reveal relative mx-auto">
        <DashboardMock />
      </div>
    </div>
  </section>

  {categories.map((cat, ci) => (
    <section class="relative px-5 py-20">
      <div class="mx-auto max-w-7xl">
        <div class="flex items-end justify-between">
          <div class="reveal">
            <p class="text-xs uppercase tracking-[0.3em] text-[var(--text-muted)]">Module {String(ci + 1).padStart(2, "0")}</p>
            <h2 class="mt-2 text-3xl font-semibold md:text-5xl">{cat.title}</h2>
          </div>
          <a href="/payment" class="hidden text-sm text-[var(--text-muted)] hover:text-[var(--text)] md:block">See plan and payment details →</a>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {cat.items.map((it, i) => (
            <FeatureCard
              title={it.t}
              description={it.d}
              icon={`<span class='text-xs font-bold'>${String(i+1).padStart(2, '0')}</span>`}
              gradient={ci === 0 ? "from-brand-500 to-accent-500" : ci === 1 ? "from-mint-400 to-brand-500" : "from-amber-400 to-accent-500"}
              delay={i * 80}
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Comparison -->
  <section class="relative px-5 py-20">
    <div class="mx-auto max-w-5xl">
      <SectionHeading eyebrow="Side-by-side" title="How Atithya compares" subtitle="A few of the alternatives teams consider before they choose us." />

      <div class="mt-10 overflow-hidden rounded-3xl glass">
        <div class="grid grid-cols-4 border-b border-white/10 px-6 py-4 text-sm font-semibold">
          <span></span>
          <span class="text-center">Atithya</span>
          <span class="text-center text-[var(--text-muted)]">Generic POS</span>
          <span class="text-center text-[var(--text-muted)]">Single feature app</span>
        </div>
        {compare.map((row, i) => (
          <div class:list={["grid grid-cols-4 px-6 py-4 text-sm", i % 2 && "bg-white/5 dark:bg-white/5"]}>
            <span>{row.label}</span>
            {[row.a, row.b, row.c].map((v, idx) => (
              <span class="flex justify-center">
                {v ? (
                  <span class={idx === 0 ? "grid h-6 w-6 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-accent-500 text-white" : "text-emerald-400"}>
                    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  </span>
                ) : (
                  <span class="text-[var(--text-muted)]">—</span>
                )}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
