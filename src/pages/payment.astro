---
import BaseLayout from "../layouts/BaseLayout.astro";

const products = [
  {
    id: "cloud-pro",
    title: "Cloud Pro Subscription",
    price: "INR 6,999 / month",
    details: "For restaurants/bars with multi-device sync, cloud backup and owner dashboard.",
  },
  {
    id: "exe-local",
    title: "Windows EXE Local License",
    price: "INR 14,999 one-time",
    details: "For local machine billing where internet is unstable. Optional cloud sync add-on available.",
  },
  {
    id: "android-license",
    title: "Android Phone App License",
    price: "INR 4,999 one-time per phone",
    details: "For waiter phone billing and live table service with secure device activation.",
  },
];
---

<BaseLayout title="Payment — Atithya">
  <section class="relative px-5 pt-20">
    <div class="mx-auto max-w-5xl text-center">
      <span class="chip reveal">Payment</span>
      <h1 class="reveal mt-4 text-5xl font-semibold tracking-tight md:text-7xl" style="transition-delay:80ms;">
        Complete payment and
        <span class="gradient-text">go live faster.</span>
      </h1>
      <p class="reveal mx-auto mt-6 max-w-2xl text-[var(--text-muted)] md:text-lg" style="transition-delay:160ms;">
        Yahan se aap cloud subscription, Windows EXE local license, ya Android app license purchase kar sakte ho.
        Payment ke baad invoice, download links aur activation details share kiye jayenge.
      </p>
    </div>
  </section>

  <section class="relative px-5 py-14">
    <div class="mx-auto grid max-w-7xl gap-5 md:grid-cols-3">
      {products.map((product, i) => (
        <article class="reveal rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] p-6 shadow-sm" style={`transition-delay:${i*70}ms`}>
          <p class="text-lg font-semibold">{product.title}</p>
          <p class="mt-2 text-base font-medium">{product.price}</p>
          <p class="mt-2 text-sm text-[var(--text-muted)]">{product.details}</p>
          <label class="mt-4 flex items-center gap-2 text-sm">
            <input type="radio" name="product" value={product.id} class="h-4 w-4" />
            Select this product
          </label>
        </article>
      ))}
    </div>
  </section>

  <section class="relative px-5 pb-20">
    <div class="mx-auto max-w-5xl rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] p-6 shadow-sm md:p-8">
      <h2 class="text-2xl font-semibold md:text-3xl">Buyer details</h2>
      <p class="mt-2 text-sm text-[var(--text-muted)]">Use business details for proper GST invoice and faster activation.</p>

      <form class="mt-6 grid gap-4 md:grid-cols-2">
        <label for="name" class="block">
          <span class="text-xs font-medium text-[var(--text-muted)]">Full name</span>
          <input id="name" type="text" placeholder="Your name" class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--ring)]" />
        </label>

        <label for="email" class="block">
          <span class="text-xs font-medium text-[var(--text-muted)]">Work email</span>
          <input id="email" type="email" placeholder="you@business.com" class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--ring)]" />
        </label>

        <label for="phone" class="block">
          <span class="text-xs font-medium text-[var(--text-muted)]">Phone number</span>
          <input id="phone" type="tel" placeholder="+91" class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--ring)]" />
        </label>

        <label for="business" class="block">
          <span class="text-xs font-medium text-[var(--text-muted)]">Business name</span>
          <input id="business" type="text" placeholder="Venue / Company" class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--ring)]" />
        </label>

        <label for="qty" class="block">
          <span class="text-xs font-medium text-[var(--text-muted)]">Quantity</span>
          <input id="qty" type="number" min="1" value="1" class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--ring)]" />
        </label>

        <label for="gst" class="block">
          <span class="text-xs font-medium text-[var(--text-muted)]">GSTIN (optional)</span>
          <input id="gst" type="text" placeholder="For business invoice" class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--ring)]" />
        </label>

        <label for="notes" class="block md:col-span-2">
          <span class="text-xs font-medium text-[var(--text-muted)]">Deployment notes</span>
          <textarea id="notes" rows="4" placeholder="Example: 2 POS counters + 3 waiter phones + 1 manager dashboard" class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--ring)]"></textarea>
        </label>

        <div class="md:col-span-2 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--surface-border)] pt-4">
          <p class="text-xs text-[var(--text-muted)]">After request, our team shares secure payment link and activation timeline.</p>
          <button type="submit" class="btn-primary">Request payment link</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
