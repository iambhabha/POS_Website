---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";

const platforms = [
  {
    name: "macOS",
    version: "4.0.2 · Universal",
    size: "142 MB",
    gradient: "from-slate-500 to-slate-900",
    icon: "<path d='M16.5 2.5c-.9 1-2.2 1.7-3.5 1.6-.2-1.3.4-2.7 1.3-3.6.9-1 2.3-1.6 3.5-1.6.1 1.3-.4 2.6-1.3 3.6zM19.8 17.2c-.5 1.1-.7 1.6-1.3 2.6-.9 1.4-2.2 3.1-3.8 3.1-1.4 0-1.8-.9-3.7-.9-1.9 0-2.3.9-3.8.9-1.6 0-2.8-1.6-3.7-3C.7 16.2.4 11.2 3.4 8.5c1-.9 2.3-1.4 3.6-1.4 1.4 0 2.3.9 3.7.9 1.3 0 2.1-.9 3.8-.9 1.2 0 2.5.6 3.4 1.6-3 1.6-2.5 5.9.9 7.5z'/>",
  },
  {
    name: "Windows",
    version: "4.0.2 · x64 / ARM",
    size: "128 MB",
    gradient: "from-brand-500 to-brand-700",
    icon: "<path d='M3 5.5 11 4v8H3zM13 3.8l8-1.3V12h-8zM3 12h8v8l-8-1.5zM13 12h8v9.5L13 20z'/>",
  },
  {
    name: "iPad / iOS",
    version: "4.0 · iOS 16+",
    size: "On the App Store",
    gradient: "from-accent-500 to-accent-600",
    icon: "<rect x='5' y='2' width='14' height='20' rx='3'/><circle cx='12' cy='18' r='1'/>",
  },
  {
    name: "Android",
    version: "4.0 · Android 11+",
    size: "On Google Play",
    gradient: "from-mint-400 to-mint-500",
    icon: "<path d='M7 7h10l1 5a4 4 0 1 1-12 0zM9 4l1 2M15 4l-1 2M8 15v4M16 15v4'/>",
  },
  {
    name: "Linux",
    version: "4.0.2 · AppImage",
    size: "118 MB",
    gradient: "from-amber-400 to-rose-500",
    icon: "<circle cx='12' cy='10' r='4'/><path d='M7 20c1-2 3-3 5-3s4 1 5 3'/>",
  },
  {
    name: "Web",
    version: "Always the latest",
    size: "Zero install",
    gradient: "from-purple-400 to-brand-500",
    icon: "<circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18'/>",
  },
];

const changelog = [
  { v: "v4.0.2", d: "Faster offline sync, new chip-based taxonomy filter in reports." },
  { v: "v4.0.0", d: "Rewritten POS engine, hotel PMS GA, guest memory." },
  { v: "v3.9.4", d: "Pour weights, automated 86-lists, Stripe Terminal S700." },
];
---

<BaseLayout title="Download — Barista">
  <section class="relative px-5 pt-20">
    <div class="mx-auto max-w-5xl text-center">
      <span class="chip reveal">Downloads</span>
      <h1 class="reveal mt-4 text-5xl font-semibold tracking-tight md:text-7xl" style="transition-delay:80ms;">
        Install Barista
        <span class="gradient-text animate-gradient">everywhere.</span>
      </h1>
      <p class="reveal mx-auto mt-6 max-w-xl text-[var(--text-muted)] md:text-lg" style="transition-delay:160ms;">
        Native apps for every platform your team uses. Your data syncs in real-time and works beautifully offline.
      </p>
    </div>
  </section>

  <section class="relative px-5 py-16">
    <div class="mx-auto grid max-w-7xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {platforms.map((p, i) => (
        <article class="reveal card-3d group relative overflow-hidden rounded-3xl glass p-6" style={`transition-delay:${i*60}ms`}>
          <div class={`tilt-layer grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br ${p.gradient} text-white shadow-lg`}>
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill={p.name === "macOS" ? "currentColor" : "none"} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={p.icon} />
            </svg>
          </div>
          <h3 class="tilt-layer mt-5 text-xl font-semibold">{p.name}</h3>
          <p class="tilt-layer mt-1 text-sm text-[var(--text-muted)]">{p.version} · {p.size}</p>

          <div class="tilt-layer mt-6 flex items-center gap-2">
            <a href="#" class="btn-primary !py-2 !px-4 text-sm">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v14M6 11l6 6 6-6M5 21h14"/></svg>
              Download
            </a>
            <a href="#" class="btn-ghost !py-2 !px-4 text-sm">Release notes</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="relative px-5 py-20">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2">
      <div class="reveal">
        <SectionHeading eyebrow="Changelog" title="What’s new" align="left" />
        <div class="mt-8 space-y-5">
          {changelog.map((c) => (
            <div class="flex items-start gap-4">
              <span class="mt-1 grid h-8 w-8 flex-none place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-accent-500 text-white text-xs font-semibold">{c.v.replace("v", "")}</span>
              <p class="text-sm text-[var(--text-muted)]">{c.d}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="reveal glass rounded-3xl p-6" style="transition-delay:120ms;">
        <p class="text-sm font-semibold">System requirements</p>
        <ul class="mt-4 space-y-2.5 text-sm text-[var(--text-muted)]">
          <li>macOS 12 or later · 4GB RAM</li>
          <li>Windows 10/11 · x64 or ARM</li>
          <li>iPad with iPadOS 16 or later</li>
          <li>Android 11+ with 3GB RAM</li>
          <li>Any modern browser for Barista Web</li>
        </ul>
        <div class="divider-gradient my-6"></div>
        <p class="text-sm">Need an enterprise installer or MDM package?</p>
        <a href="/contact" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-500 hover:text-accent-500">Contact sales →</a>
      </aside>
    </div>
  </section>
</BaseLayout>
