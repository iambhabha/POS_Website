---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import StatCard from "../components/StatCard.astro";
import LineChart from "../components/LineChart.astro";
import DonutChart from "../components/DonutChart.astro";

const sidebar = [
  { href: "/dashboard", label: "Overview", icon: "<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='7' height='9' rx='1.5'/><rect x='14' y='3' width='7' height='5' rx='1.5'/><rect x='14' y='12' width='7' height='9' rx='1.5'/><rect x='3' y='16' width='7' height='5' rx='1.5'/></svg>" },
  { href: "/dashboard/pos", label: "POS", icon: "<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='5' width='18' height='14' rx='2'/><path d='M3 10h18M8 15h3'/></svg>" },
  { href: "/dashboard/reservations", label: "Reservations", icon: "<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg>", badge: "12" },
  { href: "/dashboard/menu", label: "Menu", icon: "<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 4h16v4H4zM4 12h16v4H4zM4 20h10'/></svg>" },
  { href: "/dashboard/inventory", label: "Inventory", icon: "<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 8l-9-5-9 5 9 5 9-5z'/><path d='M3 13l9 5 9-5M3 18l9 5 9-5'/></svg>" },
  { href: "/dashboard/insights", label: "Insights", icon: "<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 3v18h18'/><path d='M7 15l4-4 4 2 5-6'/></svg>" },
  { href: "/dashboard/team", label: "Team", icon: "<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='8' r='4'/><path d='M2 21c0-4 3-7 7-7s7 3 7 7'/></svg>" },
  { href: "/admin", label: "Admin panel", icon: "<svg viewBox='0 0 24 24' class='h-4 w-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 15l-3 6h6l-3-6zM5 3h14l-1 9H6z'/></svg>" },
];

const orders = [
  { id: "#48211", table: "Bar · Seat 3", items: 4, total: "$184.20", status: "Served" },
  { id: "#48210", table: "Patio · T12", items: 7, total: "$412.75", status: "Preparing" },
  { id: "#48209", table: "Main · T04", items: 3, total: "$96.40", status: "Served" },
  { id: "#48208", table: "Main · T07", items: 5, total: "$248.90", status: "Sent" },
  { id: "#48207", table: "Bar · Seat 8", items: 2, total: "$42.10", status: "Served" },
];
---

<DashboardLayout
  title="Dashboard — Barista"
  items={sidebar}
  footer={{ name: "Alex Moreau", role: "Front of House Manager" }}
  pageTitle="Overview"
  pageSubtitle="Monday, Apr 19 · Service starts in 42 minutes"
>
  <!-- Stat cards -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard label="Revenue today" value="$12,482" delta="+14.2%" icon="<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/></svg>" gradient="from-brand-500 to-brand-700" delay={0} />
    <StatCard label="Covers" value="284" delta="+6.4%" icon="<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='8' r='4'/><path d='M2 21c0-4 3-7 7-7s7 3 7 7'/></svg>" gradient="from-accent-500 to-accent-600" delay={80} />
    <StatCard label="Avg ticket" value="$43.90" delta="+2.1%" icon="<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6L9 17l-5-5'/></svg>" gradient="from-mint-400 to-mint-500" delay={160} />
    <StatCard label="Occupancy" value="86%" delta="-1.4%" deltaDirection="down" icon="<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 12l9-8 9 8'/><path d='M5 10v10h14V10'/></svg>" gradient="from-amber-400 to-rose-500" delay={240} />
  </section>

  <!-- Charts row -->
  <section class="mt-6 grid gap-4 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <LineChart id="sales" />
    </div>
    <DonutChart />
  </section>

  <!-- Lower row: orders + upcoming reservations -->
  <section class="mt-6 grid gap-4 lg:grid-cols-3">
    <article class="reveal glass rounded-3xl p-6 lg:col-span-2">
      <header class="flex items-center justify-between">
        <div>
          <p class="text-sm font-semibold">Active orders</p>
          <p class="text-xs text-[var(--text-muted)]">Auto-refresh · 5s</p>
        </div>
        <button class="btn-ghost !py-1.5 !px-3 text-xs">View all</button>
      </header>
      <div class="mt-4 overflow-x-auto scrollbar-hidden">
        <table class="w-full text-sm">
          <thead class="text-xs uppercase tracking-wider text-[var(--text-muted)]">
            <tr class="text-left">
              <th class="py-3 pr-4 font-medium">Order</th>
              <th class="py-3 pr-4 font-medium">Table</th>
              <th class="py-3 pr-4 font-medium">Items</th>
              <th class="py-3 pr-4 font-medium">Total</th>
              <th class="py-3 pr-4 font-medium">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {orders.map((o) => (
              <tr class="transition-colors hover:bg-white/5">
                <td class="py-3 pr-4 font-semibold">{o.id}</td>
                <td class="py-3 pr-4">{o.table}</td>
                <td class="py-3 pr-4">{o.items}</td>
                <td class="py-3 pr-4">{o.total}</td>
                <td class="py-3 pr-4">
                  <span class:list={[
                    "rounded-full px-2.5 py-1 text-[11px] font-medium",
                    o.status === "Served" && "bg-emerald-400/15 text-emerald-400",
                    o.status === "Preparing" && "bg-amber-400/15 text-amber-400",
                    o.status === "Sent" && "bg-brand-500/15 text-brand-500",
                  ]}>{o.status}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </article>

    <article class="reveal glass rounded-3xl p-6">
      <header class="flex items-center justify-between">
        <div>
          <p class="text-sm font-semibold">Tonight’s bookings</p>
          <p class="text-xs text-[var(--text-muted)]">Next 3 hours</p>
        </div>
        <span class="chip !py-1 !px-2 text-[10px]">18 tables</span>
      </header>

      <ul class="mt-4 space-y-3">
        {[
          { name: "Camila S.", time: "19:00", size: "2", note: "Anniversary" },
          { name: "Tomás R.", time: "19:30", size: "4", note: "VIP" },
          { name: "Aya K.", time: "20:00", size: "6", note: "Gluten free" },
          { name: "Noé B.", time: "20:30", size: "3" },
        ].map((r) => (
          <li class="flex items-center gap-3 rounded-2xl glass p-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-brand-400 to-accent-500 text-sm font-semibold text-white">{r.time}</span>
            <div class="flex-1 min-w-0">
              <p class="truncate text-sm font-semibold">{r.name}</p>
              <p class="truncate text-xs text-[var(--text-muted)]">Party of {r.size}{r.note ? ` · ${r.note}` : ""}</p>
            </div>
            <button class="grid h-8 w-8 place-items-center rounded-full glass">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </li>
        ))}
      </ul>
    </article>
  </section>

  <!-- Bottom band: shortcuts -->
  <section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {[
      { t: "New order", d: "Open a tab and start firing tickets", g: "from-brand-500 to-accent-500" },
      { t: "Add reservation", d: "Drop a guest on the floor plan", g: "from-accent-500 to-accent-600" },
      { t: "86 an item", d: "Flag it across every terminal instantly", g: "from-amber-400 to-rose-500" },
      { t: "Cash-in drawer", d: "Start a shift or reconcile float", g: "from-mint-400 to-mint-500" },
    ].map((q, i) => (
      <button class="reveal card-3d text-left glass rounded-3xl p-5 transition-transform" style={`transition-delay:${i*60}ms`}>
        <span class={`tilt-layer grid h-10 w-10 place-items-center rounded-2xl bg-gradient-to-br ${q.g} text-white`}>
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        </span>
        <p class="tilt-layer mt-4 text-sm font-semibold">{q.t}</p>
        <p class="tilt-layer mt-1 text-xs text-[var(--text-muted)]">{q.d}</p>
      </button>
    ))}
  </section>
</DashboardLayout>
