---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";

const plans = [
  {
    name: "Starter",
    price: { m: 39, y: 31 },
    tagline: "For neighbourhood cafés & wine bars.",
    features: [
      "1 venue, up to 3 terminals",
      "POS + reservations",
      "Inventory basics",
      "Email support",
    ],
    highlight: false,
  },
  {
    name: "Growth",
    price: { m: 99, y: 79 },
    tagline: "For restaurants, bars & busy venues.",
    features: [
      "Up to 3 venues, unlimited terminals",
      "Kitchen display + prep routing",
      "Advanced inventory & pours",
      "Analytics workspace",
      "Priority support",
    ],
    highlight: true,
  },
  {
    name: "Hotel",
    price: { m: 249, y: 199 },
    tagline: "Boutique hotels & multi-venue groups.",
    features: [
      "Full PMS + channel manager",
      "Housekeeping & folios",
      "Unlimited venues & properties",
      "Dedicated CSM",
      "99.99% SLA",
    ],
    highlight: false,
  },
];

const faqs = [
  { q: "Is there a free trial?", a: "Yes — 21 days, no credit card required. You’ll keep access to your data even if you don’t convert." },
  { q: "Do you charge per terminal?", a: "No. Plans are per venue with unlimited terminals and staff accounts on Growth and Hotel." },
  { q: "Can I switch plans later?", a: "Any time. Upgrades are prorated to the day, downgrades take effect at the next cycle." },
  { q: "What about hardware?", a: "Barista runs on iPad, Android, web and our optional Barista Terminal. Bring your own or lease from us." },
];
---

<BaseLayout title="Pricing — Barista">
  <section class="relative px-5 pt-20">
    <div class="mx-auto max-w-5xl text-center">
      <span class="chip reveal">Pricing</span>
      <h1 class="reveal mt-4 text-5xl font-semibold tracking-tight md:text-7xl" style="transition-delay:80ms;">
        Simple pricing.
        <span class="gradient-text animate-gradient">Serious hospitality.</span>
      </h1>
      <p class="reveal mx-auto mt-6 max-w-xl text-[var(--text-muted)] md:text-lg" style="transition-delay:160ms;">
        Start free for 21 days on any plan. Switch or cancel whenever. Pricing below is per venue.
      </p>

      <div class="reveal mt-8 inline-flex items-center gap-1 rounded-full glass p-1" style="transition-delay:240ms;">
        <button data-billing="m" class="billing-btn is-active relative rounded-full px-4 py-1.5 text-sm font-medium text-white transition">
          <span class="absolute inset-0 -z-10 rounded-full bg-gradient-to-r from-brand-500 to-accent-500"></span>
          Monthly
        </button>
        <button data-billing="y" class="billing-btn relative rounded-full px-4 py-1.5 text-sm font-medium text-[var(--text-muted)] transition">
          Yearly · save 20%
        </button>
      </div>
    </div>
  </section>

  <section class="relative px-5 py-16">
    <div class="mx-auto grid max-w-7xl gap-6 md:grid-cols-3">
      {plans.map((p, i) => (
        <article
          class:list={[
            "reveal relative overflow-hidden rounded-3xl p-7",
            p.highlight ? "glass-strong ring-2 ring-brand-500/50 shadow-2xl scale-[1.01]" : "glass",
          ]}
          style={`transition-delay:${i*90}ms`}
        >
          {p.highlight && (
            <span class="absolute right-5 top-5 rounded-full bg-gradient-to-r from-accent-500 to-brand-500 px-3 py-1 text-[11px] font-semibold text-white shadow-lg">Most popular</span>
          )}
          <p class="text-sm font-semibold tracking-wide">{p.name}</p>
          <p class="mt-1 text-sm text-[var(--text-muted)]">{p.tagline}</p>
          <div class="mt-6 flex items-end gap-1">
            <span class="text-xs text-[var(--text-muted)]">$</span>
            <span class="price text-5xl font-semibold tracking-tight" data-m={p.price.m} data-y={p.price.y}>{p.price.m}</span>
            <span class="mb-1 text-sm text-[var(--text-muted)]">/venue/mo</span>
          </div>
          <a href="/download" class:list={["mt-6 block text-center", p.highlight ? "btn-primary pulse-glow" : "btn-ghost"]}>Start free trial</a>
          <ul class="mt-6 space-y-3 text-sm">
            {p.features.map((f) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 grid h-5 w-5 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-accent-500 text-white">
                  <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                </span>
                {f}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="relative px-5 py-16">
    <div class="mx-auto max-w-4xl">
      <SectionHeading eyebrow="FAQ" title="Questions, answered." />
      <div class="mt-10 divide-y divide-white/10 rounded-3xl glass">
        {faqs.map((f, i) => (
          <details class="group p-5 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium">
              {f.q}
              <span class="grid h-7 w-7 place-items-center rounded-full glass transition-transform group-open:rotate-45">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-sm text-[var(--text-muted)]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".billing-btn");
  const prices = document.querySelectorAll<HTMLElement>(".price");
  function setBilling(mode: "m" | "y") {
    prices.forEach((p) => {
      const v = p.dataset[mode];
      if (v) {
        p.classList.add("opacity-0", "translate-y-2");
        setTimeout(() => {
          p.textContent = v;
          p.classList.remove("opacity-0", "translate-y-2");
        }, 140);
      }
    });
    buttons.forEach((b) => {
      const active = b.dataset.billing === mode;
      b.classList.toggle("is-active", active);
      b.classList.toggle("text-white", active);
      b.classList.toggle("text-[var(--text-muted)]", !active);
      const existing = b.querySelector("span.absolute");
      if (active && !existing) {
        const span = document.createElement("span");
        span.className = "absolute inset-0 -z-10 rounded-full bg-gradient-to-r from-brand-500 to-accent-500";
        b.prepend(span);
      } else if (!active && existing) {
        existing.remove();
      }
    });
  }
  prices.forEach((p) => (p.style.transition = "opacity .25s ease, transform .25s ease"));
  buttons.forEach((b) => b.addEventListener("click", () => setBilling(b.dataset.billing as "m" | "y")));
</script>
