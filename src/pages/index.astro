---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeatureCard from "../components/FeatureCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DashboardMock from "../components/DashboardMock.astro";

const features = [
  { title: "Production POS", description: "Fast billing, KOT, split payment, table shift and day close for real live counters.", icon: "<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='3'/><path d='M3 9h18M9 3v18'/></svg>", gradient: "from-brand-500 to-brand-700" },
  { title: "Cloud + Local", description: "Cloud plan for multi-device sync, plus Windows EXE local mode for uninterrupted operation.", icon: "<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18'/></svg>", gradient: "from-accent-500 to-accent-600" },
  { title: "Hotel Operations", description: "Reservation desk, room status, service posting and final checkout in one workflow.", icon: "<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 12l9-8 9 8'/><path d='M5 10v10h14V10'/></svg>", gradient: "from-mint-400 to-mint-500" },
  { title: "Restaurant Control", description: "Menu, modifiers, live stock and kitchen performance dashboard with role-wise access.", icon: "<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M8 2h8l-1 5a4 4 0 0 1-6 0l-1-5z'/><path d='M12 11v11'/></svg>", gradient: "from-amber-400 to-rose-500" },
  { title: "Clear Reports", description: "Daily sales, shift-wise cash, payment method breakup and tax-ready export in one click.", icon: "<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 3v18h18'/><path d='M7 15l4-4 4 2 5-6'/></svg>", gradient: "from-brand-400 to-mint-500" },
  { title: "License Based Pricing", description: "Cloud subscription alag, Android app license alag, Windows EXE license alag with full detail.", icon: "<svg viewBox='0 0 24 24' class='h-5 w-5' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='8' r='4'/><path d='M2 21c0-4 3-7 7-7s7 3 7 7M17 10a4 4 0 0 0 0-8M22 21c0-3-2-5-5-6'/></svg>", gradient: "from-purple-400 to-brand-500" },
];
---

<BaseLayout title="Atithya — Production POS for Bar, Hotel and Restaurant">
  <Hero />

  <!-- Features grid -->
  <section class="relative px-5 py-28">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="One platform"
        title="Everything your venue needs, <span class='gradient-text'>in one production-ready system.</span>"
        subtitle="Sell, bill, manage rooms, track inventory and accept payments with clear license options for every business size."
      />

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f, i) => <FeatureCard {...f} delay={i * 60} />)}
      </div>
    </div>
  </section>

  <!-- Parallax product showcase -->
  <section class="relative overflow-hidden px-5 py-24">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div data-parallax="0.2" class="absolute left-[10%] top-20 text-[22rem] font-bold leading-none text-white/5 dark:text-white/5 select-none">/ flow</div>
    </div>
    <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
      <div class="reveal">
        <span class="chip"><span class="h-1.5 w-1.5 rounded-full bg-mint-400"></span>Built for daily live operations</span>
        <h2 class="mt-4 text-4xl font-semibold md:text-5xl">From seat to settle in
          <span class="gradient-text">with online + offline safety.</span>
        </h2>
        <p class="mt-4 max-w-lg text-[var(--text-muted)]">If internet goes down your local EXE mode continues billing. Once online, data syncs back to cloud. This is built for real production pressure, not demo use.</p>
        <ul class="mt-6 space-y-3 text-sm">
          {[
            "Windows EXE local license for uninterrupted counter billing",
            "Android phone app license for mobile order taking and service",
            "Cloud subscription for owner dashboard, backups and remote reports",
          ].map((t) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 grid h-5 w-5 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-accent-500 text-white">
                <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              {t}
            </li>
          ))}
        </ul>
      </div>
      <div class="relative reveal" style="transition-delay:120ms;">
        <div data-parallax="0.08" class="card-3d mx-auto">
          <DashboardMock />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="relative px-5 py-20">
    <div class="mx-auto max-w-7xl glass rounded-[32px] p-10 md:p-14 overflow-hidden relative">
      <div class="grid gap-8 md:grid-cols-4">
        {[
          { k: "100%", v: "Transparent pricing split by product type" },
          { k: "24x7", v: "Local billing continuity in live service hours" },
          { k: "3 Modes", v: "Cloud plan, Windows EXE, Android app license" },
          { k: "1 Flow", v: "Payment page to download and activate quickly" },
        ].map((s, i) => (
          <div class="reveal" style={`transition-delay:${i*80}ms`}>
            <p class="text-4xl font-semibold gradient-text md:text-5xl">{s.k}</p>
            <p class="mt-2 text-sm text-[var(--text-muted)]">{s.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="relative px-5 py-24">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="Why teams buy"
        title="Owners choose Atithya for <span class='gradient-text'>clear ROI and clear pricing.</span>"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {[
          { q: "Cloud plan and local EXE both mil gaye, so downtime ke time bhi billing band nahi hoti.", a: "Mireille L.", r: "GM, Aurora Hotel Group" },
          { q: "Android app license se waiter phone se order leta hai, aur counter pe direct KOT print hota hai.", a: "Tomás R.", r: "Bar Director, Mirage" },
          { q: "Payment page pe sab clear tha, kis plan me kya milega. Team onboarding fast ho gaya.", a: "Aarav P.", r: "Founder, Haven Residences" },
        ].map((t, i) => (
          <article class="reveal glass rounded-3xl p-6" style={`transition-delay:${i*100}ms`}>
            <div class="flex items-center gap-0.5 text-amber-400">
              {[0,1,2,3,4].map(() => (<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1L12 2z"/></svg>))}
            </div>
            <p class="mt-4 text-[15px] leading-relaxed">“{t.q}”</p>
            <div class="mt-6 flex items-center gap-3">
              <span class="h-10 w-10 rounded-full bg-gradient-to-br from-brand-400 to-accent-500"></span>
              <div>
                <p class="text-sm font-semibold">{t.a}</p>
                <p class="text-xs text-[var(--text-muted)]">{t.r}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative px-5 py-24">
    <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[40px] p-10 md:p-16 text-center">
      <div class="absolute inset-0 -z-10 animate-gradient bg-gradient-to-br from-brand-600 via-accent-500 to-mint-500 opacity-90"></div>
      <div class="absolute inset-0 -z-10 noise"></div>
      <h2 class="text-4xl font-semibold text-white md:text-6xl">Ready to buy for your bar, hotel or restaurant?</h2>
      <p class="mx-auto mt-4 max-w-xl text-white/80">Open payment page, select your plan type, complete payment, and download your software with setup guidance.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/payment" class="btn-primary !bg-white !text-brand-700 shadow-xl hover:shadow-2xl">
          Go to payment page
        </a>
        <a href="/pricing" class="btn-ghost !border-white/50 !text-white !bg-white/10">See full pricing details</a>
      </div>
    </div>
  </section>
</BaseLayout>
