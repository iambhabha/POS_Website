---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import DashboardMock from '../components/DashboardMock.astro';
import ChatUI from '../components/ChatUI.astro';
import ParallaxLayer from '../components/ParallaxLayer.astro';
import Reveal from '../components/Reveal.astro';

const features = [
  { index: '01', title: 'POS that understands service',    body: 'Sub-second splits, tabs that follow guests between bar and table, and a bill that reads like a menu — because it is one.', icon: 'pos' },
  { index: '02', title: 'Reservations with memory',        body: 'Every guest carries their preferences, allergies, and stories with them. Your team walks into each shift already knowing the room.', icon: 'calendar' },
  { index: '03', title: 'Inventory that forecasts',        body: 'Par-levels tuned per day-of-week and weather. The bar never runs out of Chablis on a Friday again.', icon: 'inventory' },
  { index: '04', title: 'One roster, three properties',    body: 'Schedule across hotel, bar, and restaurant with role-based costing, tips, and labour compliance built in.', icon: 'staff' },
  { index: '05', title: 'Rooms, F&B, events — one folio',  body: 'A single bill for the room, the minibar, the tasting menu, and the anniversary cake. No reconciliation at midnight.', icon: 'rooms' },
  { index: '06', title: 'Insight without dashboards',      body: 'A short, written read on last night — what worked, what didn\'t, what to change by tomorrow. Delivered at 7:00.', icon: 'insights' },
];

const testimonials = [
  { quote: 'Maison is the first system that didn\'t feel like software. It feels like a good maître d\'.', author: 'Ines Moreau', role: 'Head of hospitality, Kenzo Group', venue: '3 properties · Paris' },
  { quote: 'We cut our reconciliation work from 9 hours a week to under 30 minutes. That\'s another full shift of service.', author: 'Matteo Rinaldi', role: 'GM, Aurum Bar', venue: 'Cocktail bar · Milan' },
  { quote: 'Guests notice things they can\'t quite name. The quiet between courses. The way their second table is free. That\'s Maison in the background.', author: 'Jun Watanabe', role: 'Chef-owner, Hotel Kōya', venue: 'Boutique hotel · Kyoto' },
];
---

<BaseLayout title="Maison — Hospitality, run with the grain of craft" current="">

  <Hero />

  <!-- ===================== FEATURES TEASER ===================== -->
  <section class="relative py-24 sm:py-32">
    <div class="container-edge">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div class="lg:sticky lg:top-32 lg:self-start">
          <SectionHeading
            eyebrow="What it is"
            title="One system. Every service. No seams."
            highlight="seams"
            lead="Maison unifies point-of-sale, reservations, rooms, inventory, and guest memory so your team spends less time tabbing between apps — and more time on the floor."
          />
          <Reveal class="mt-10 flex flex-wrap gap-3">
            <a href="/features" class="btn-primary">Explore features</a>
            <a href="/dashboard" class="btn-ghost">See a live shift</a>
          </Reveal>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {features.map((f, i) => (
            <FeatureCard index={f.index} title={f.title} body={f.body} icon={f.icon as any}
                         tone={i === 0 ? 'ink' : i === 3 ? 'warm' : 'paper'} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== LIVE DASHBOARD ===================== -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <ParallaxLayer speed={-0.1} class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[560px] w-[560px] -translate-x-1/2 rounded-full bg-paper-cream/60 blur-3xl"></div>
    </ParallaxLayer>

    <div class="container-edge">
      <SectionHeading
        eyebrow="Service mode"
        title="See the room the way your best manager does."
        align="center"
        lead="A calm, live view of the night — revenue, covers, stations, stock — with the detail you need and none of the noise you don't."
      />
      <Reveal mode="scale" class="mt-16">
        <DashboardMock />
      </Reveal>
    </div>
  </section>

  <!-- ===================== BRIDGE / QUOTE ===================== -->
  <section class="relative py-24">
    <div class="container-edge">
      <Reveal>
        <blockquote class="mx-auto max-w-4xl text-balance text-center font-display text-[2.25rem] leading-[1.12] tracking-tightest text-ink sm:text-[3rem]">
          <span class="text-brass-500">"</span>Software should <em class="not-italic">disappear</em> into
          the rhythm of a night — and <em class="not-italic">appear</em> only when it's useful.<span class="text-brass-500">"</span>
        </blockquote>
        <div class="mt-8 flex items-center justify-center gap-4 text-sm text-ink-500">
          <span class="h-px w-8 bg-ink-300"></span>
          <span>Ines Moreau · Kenzo Group</span>
          <span class="h-px w-8 bg-ink-300"></span>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- ===================== CHAT / GUEST MEMORY ===================== -->
  <section class="relative overflow-hidden bg-paper-warm/60 py-24 sm:py-32">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-paper to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-paper to-transparent"></div>

    <div class="container-edge relative grid items-center gap-16 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div>
        <SectionHeading
          eyebrow="Guest memory"
          title="Hospitality starts with remembering."
          highlight="remembering"
          lead="Every visit, preference, allergy, and story flows with the guest — from reception to bar to table — and lands, quietly, in front of the right staff member at the right moment."
        />
        <Reveal class="mt-10 grid grid-cols-2 gap-6 text-sm">
          <div>
            <div class="num text-3xl text-ink">14 visits</div>
            <div class="mt-1 text-ink-500">Clara knows what she wants. Now so do you.</div>
          </div>
          <div>
            <div class="num text-3xl text-ink">0 ms</div>
            <div class="mt-1 text-ink-500">Service AI reacts in the margins, never in the way.</div>
          </div>
        </Reveal>
        <Reveal class="mt-10">
          <a href="/features" class="btn-ghost">How memory works →</a>
        </Reveal>
      </div>

      <Reveal mode="right">
        <ChatUI />
      </Reveal>
    </div>
  </section>

  <!-- ===================== VENUES ===================== -->
  <section class="relative py-24 sm:py-32">
    <div class="container-edge">
      <SectionHeading eyebrow="Venues" title="One platform, every kind of room." align="center" />

      <div class="mt-14 grid gap-px overflow-hidden border border-ink/10 bg-ink/10 md:grid-cols-3">
        {[
          { name: 'Restaurants', desc: 'From tasting menus to pizzerias — course-pacing, allergen flows, and split bills that don\'t break friendships.', meta: '04 modules · 120+ POS devices' },
          { name: 'Bars',        desc: 'Sub-second tabs, cocktail specs, pour costing, and staff tipping calibrated for volume nights.', meta: '03 modules · Live stock' },
          { name: 'Hotels',      desc: 'Rooms, F&B, spa, events — a single folio and a single nightly audit that actually audits.', meta: '05 modules · PMS-ready' },
        ].map((v, i) => (
          <Reveal delay={i * 100}>
            <div class="relative h-full bg-paper p-8 transition-colors hover:bg-paper-warm">
              <div class="eyebrow text-ink-400">0{i + 1}</div>
              <h3 class="mt-6 font-display text-3xl tracking-tight text-ink">{v.name}</h3>
              <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-500">{v.desc}</p>
              <div class="mono mt-8 text-[0.7rem] tracking-wide text-ink-400">{v.meta}</div>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TESTIMONIALS ===================== -->
  <section class="relative overflow-hidden bg-ink py-24 text-paper sm:py-32">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-paper to-transparent opacity-20"></div>

    <ParallaxLayer speed={0.08} class="pointer-events-none absolute -right-40 top-10 h-[500px] w-[500px]">
      <div class="h-full w-full rounded-full bg-brass-500/15 blur-3xl"></div>
    </ParallaxLayer>

    <div class="container-edge relative">
      <div class="max-w-3xl">
        <div data-reveal class="eyebrow mb-6 flex items-center gap-3 text-paper/60">
          <span class="h-px w-8 bg-paper/40"></span>
          Voices
        </div>
        <h2 data-reveal class="font-display text-4xl leading-[1.04] tracking-tightest sm:text-5xl lg:text-6xl">
          What hoteliers, chefs and bar owners say when the review cameras are off.
        </h2>
      </div>

      <div class="mt-16 grid gap-px overflow-hidden border border-paper/10 bg-paper/10 md:grid-cols-3">
        {testimonials.map((t, i) => (
          <Reveal delay={i * 120}>
            <figure class="h-full bg-ink p-8">
              <blockquote class="font-display text-[1.25rem] leading-[1.35] tracking-tight text-paper">
                "{t.quote}"
              </blockquote>
              <figcaption class="mt-8 border-t border-paper/15 pt-4 text-[0.8rem] text-paper/70">
                <div class="text-paper">{t.author}</div>
                <div>{t.role}</div>
                <div class="mono mt-1 text-[0.65rem] text-paper/50">{t.venue}</div>
              </figcaption>
            </figure>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="relative overflow-hidden py-28">
    <div class="hero-aurora absolute inset-0 -z-10 opacity-70"></div>
    <div class="grain absolute inset-0 -z-10"></div>

    <div class="container-edge">
      <Reveal mode="scale">
        <div class="relative mx-auto max-w-4xl border border-ink/15 bg-paper p-12 text-center sm:p-20">
          <div class="eyebrow mb-5 text-ink-500">Ready when you are</div>
          <h2 class="font-display text-4xl leading-[1.04] tracking-tightest text-ink sm:text-6xl">
            Move your house onto <em class="not-italic"><span class="underline-brass">Maison</span></em>.
          </h2>
          <p class="mx-auto mt-6 max-w-xl text-ink-500">
            30-day trial. White-glove migration from Toast, Lightspeed, Mews, and the spreadsheet
            you've been meaning to retire for years.
          </p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a href="/download" class="btn-primary">Start free trial</a>
            <a href="/contact" class="btn-ghost">Book a walkthrough</a>
          </div>
          <div class="mono mt-10 text-[0.65rem] tracking-[0.22em] text-ink-400">
            · NO CARD · CANCEL ANYTIME · AVERAGE MIGRATION 6 DAYS ·
          </div>
        </div>
      </Reveal>
    </div>
  </section>

</BaseLayout>
