---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — Atithya">
  <section class="relative px-5 pt-20">
    <div class="mx-auto max-w-5xl text-center">
      <span class="chip reveal">Talk to us</span>
      <h1 class="reveal mt-4 text-5xl font-semibold tracking-tight md:text-7xl" style="transition-delay:80ms;">
        Sales and onboarding
        <span class="gradient-text">for your production setup.</span>
      </h1>
      <p class="reveal mx-auto mt-6 max-w-2xl text-[var(--text-muted)] md:text-lg" style="transition-delay:160ms;">
        Share your exact requirement and we will suggest the right combination of cloud plan, Windows EXE license and Android phone licenses.
      </p>
    </div>
  </section>

  <section class="relative px-5 py-16">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div class="reveal space-y-5">
        {[
          { t: "Sales", d: "sales@Atithya.app", s: "Plan and pricing guidance" },
          { t: "Activation", d: "activation@Atithya.app", s: "License key and setup help" },
          { t: "Support", d: "support@Atithya.app", s: "Live venue technical support" },
        ].map((c, i) => (
          <article class="rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] p-6 shadow-sm" style={`transition-delay:${i*80}ms`}>
            <p class="text-xs uppercase tracking-[0.3em] text-[var(--text-muted)]">{c.t}</p>
            <p class="mt-2 text-xl font-semibold">{c.d}</p>
            <p class="mt-1 text-sm text-[var(--text-muted)]">{c.s}</p>
          </article>
        ))}

        <div class="rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] p-6 shadow-sm reveal">
          <p class="text-sm font-semibold">Regional teams</p>
          <div class="mt-4 grid grid-cols-2 gap-3 text-sm text-[var(--text-muted)]">
            <div>
              <p class="font-medium text-[var(--text)]">Mumbai</p>
              <p>BKC, Bandra East</p>
            </div>
            <div>
              <p class="font-medium text-[var(--text)]">Delhi NCR</p>
              <p>Sector 62, Noida</p>
            </div>
            <div>
              <p class="font-medium text-[var(--text)]">Bengaluru</p>
              <p>Outer Ring Road</p>
            </div>
            <div>
              <p class="font-medium text-[var(--text)]">Hyderabad</p>
              <p>HITEC City</p>
            </div>
          </div>
        </div>
      </div>

      <form class="reveal rounded-2xl border border-[var(--surface-border)] bg-[var(--surface)] p-6 shadow-sm md:p-8" style="transition-delay:120ms;">
        <div class="grid gap-4 md:grid-cols-2">
          {[
            { id: "first", l: "First name", ph: "Rahul" },
            { id: "last", l: "Last name", ph: "Sharma" },
            { id: "email", l: "Work email", ph: "rahul@venue.com", full: true, type: "email" },
            { id: "company", l: "Venue / Business name", ph: "Downtown Restobar", full: true },
          ].map((f) => (
            <label class:list={["block", f.full && "md:col-span-2"]} for={f.id}>
              <span class="text-xs font-medium text-[var(--text-muted)]">{f.l}</span>
              <input id={f.id} type={f.type || "text"} placeholder={f.ph} class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--ring)]" />
            </label>
          ))}

          <label class="md:col-span-2" for="size">
            <span class="text-xs font-medium text-[var(--text-muted)]">How many billing devices do you need?</span>
            <div class="mt-1.5 grid grid-cols-4 gap-2">
              {["1-2", "3-5", "6-10", "10+"].map((s) => (
                <button type="button" class="chip-option rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-3 py-2.5 text-sm hover:border-[var(--text-muted)]">{s}</button>
              ))}
            </div>
          </label>

          <label class="md:col-span-2" for="msg">
            <span class="text-xs font-medium text-[var(--text-muted)]">Tell us your exact requirement</span>
            <textarea id="msg" rows="5" placeholder="Example: 2 Windows EXE counters + 4 Android waiter phones + cloud owner dashboard" class="mt-1.5 w-full rounded-md border border-[var(--surface-border)] bg-[var(--bg)] px-4 py-3 text-sm placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--ring)]"></textarea>
          </label>

          <div class="md:col-span-2 flex items-center justify-between gap-3">
            <p class="text-xs text-[var(--text-muted)]">We will respond with quote and payment path within 1 business day.</p>
            <button class="btn-primary" type="submit">
              Send requirement
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".chip-option").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".chip-option").forEach((b) => b.classList.remove("!border-[var(--text)]", "!bg-[var(--bg-soft)]", "!text-[var(--text)]"));
      btn.classList.add("!border-[var(--text)]", "!bg-[var(--bg-soft)]", "!text-[var(--text)]");
    });
  });
</script>
