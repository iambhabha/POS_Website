---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reveal from '../components/Reveal.astro';

const offices = [
  { city: 'Copenhagen', role: 'HQ · Product & engineering', addr: 'Pilestræde 12\n1112 København K\nDenmark', tz: 'UTC+1' },
  { city: 'Singapore',  role: 'APAC · Hotels & groups',      addr: '1 Raffles Place #32-01\nOne Raffles Place\nSingapore 048616', tz: 'UTC+8' },
  { city: 'Milan',      role: 'South Europe · F&B',          addr: 'Via della Spiga 3\n20121 Milano\nItalia', tz: 'UTC+1' },
];
---
<BaseLayout title="Contact — Maison" current="contact">

  <section class="relative overflow-hidden pb-20 pt-36 sm:pt-44">
    <div class="hero-aurora absolute inset-0 -z-10 opacity-70"></div>

    <div class="container-edge">
      <div class="grid gap-16 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
        <div>
          <Reveal class="eyebrow mb-6 flex items-center gap-3 text-ink-500">
            <span class="h-px w-8 bg-ink-400"></span>Contact
          </Reveal>
          <Reveal>
            <h1 class="font-display text-5xl leading-[1.02] tracking-tightest text-ink sm:text-7xl">
              Write to us<br/>
              <span class="text-ink-500">the way you'd write</span><br/>
              to a <em class="not-italic italic-serif"><span class="underline-brass">friend</span></em>.
            </h1>
          </Reveal>
          <Reveal delay={120}>
            <p class="mt-8 max-w-xl text-lg text-ink-500">
              Tell us about your venue — what works, what doesn't, what a Friday looks like.
              We reply from the same desk we build from, usually the same day.
            </p>
          </Reveal>

          <Reveal delay={220} class="mt-14 grid gap-4 text-sm sm:grid-cols-2">
            <a href="mailto:hello@maison.hospitality" class="group flex items-center justify-between border-b border-ink/10 py-4">
              <div>
                <div class="mono text-[0.68rem] tracking-wide text-ink-400">GENERAL</div>
                <div class="mt-1 text-ink">hello@maison.hospitality</div>
              </div>
              <span class="text-brass-600 transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a href="mailto:sales@maison.hospitality" class="group flex items-center justify-between border-b border-ink/10 py-4">
              <div>
                <div class="mono text-[0.68rem] tracking-wide text-ink-400">SALES</div>
                <div class="mt-1 text-ink">sales@maison.hospitality</div>
              </div>
              <span class="text-brass-600 transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a href="mailto:support@maison.hospitality" class="group flex items-center justify-between border-b border-ink/10 py-4">
              <div>
                <div class="mono text-[0.68rem] tracking-wide text-ink-400">SUPPORT</div>
                <div class="mt-1 text-ink">support@maison.hospitality</div>
              </div>
              <span class="text-brass-600 transition-transform group-hover:translate-x-1">→</span>
            </a>
            <a href="mailto:press@maison.hospitality" class="group flex items-center justify-between border-b border-ink/10 py-4">
              <div>
                <div class="mono text-[0.68rem] tracking-wide text-ink-400">PRESS</div>
                <div class="mt-1 text-ink">press@maison.hospitality</div>
              </div>
              <span class="text-brass-600 transition-transform group-hover:translate-x-1">→</span>
            </a>
          </Reveal>
        </div>

        <!-- Form -->
        <Reveal mode="right">
          <form class="relative border border-ink/10 bg-paper p-8 sm:p-10" onsubmit="event.preventDefault(); alert('Thanks — we will reply within a day.');">
            <div class="eyebrow mb-6 text-ink-500">Send us a note</div>

            <div class="grid gap-5">
              <label class="block">
                <span class="text-[0.8rem] text-ink-500">Your name</span>
                <input type="text" required class="mt-2 w-full border-b border-ink/15 bg-transparent pb-2 text-ink placeholder-ink-400 focus:border-ink focus:outline-none" placeholder="Ines Moreau"/>
              </label>

              <label class="block">
                <span class="text-[0.8rem] text-ink-500">Email</span>
                <input type="email" required class="mt-2 w-full border-b border-ink/15 bg-transparent pb-2 text-ink placeholder-ink-400 focus:border-ink focus:outline-none" placeholder="you@venue.com"/>
              </label>

              <label class="block">
                <span class="text-[0.8rem] text-ink-500">Venue type</span>
                <select class="mt-2 w-full border-b border-ink/15 bg-transparent pb-2 text-ink focus:border-ink focus:outline-none">
                  <option>Restaurant</option>
                  <option>Bar / cocktail</option>
                  <option>Hotel (boutique)</option>
                  <option>Hotel (full-service)</option>
                  <option>Group / multi-location</option>
                </select>
              </label>

              <label class="block">
                <span class="text-[0.8rem] text-ink-500">Tell us about your room</span>
                <textarea rows="4" class="mt-2 w-full border-b border-ink/15 bg-transparent pb-2 text-ink placeholder-ink-400 focus:border-ink focus:outline-none resize-none" placeholder="A Friday night, in three sentences…"></textarea>
              </label>
            </div>

            <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
              <div class="flex items-center gap-2 text-[0.72rem] text-ink-500">
                <span class="inline-flex h-1.5 w-1.5 rounded-full bg-green-500"></span>
                Replies within 1 business day
              </div>
              <button type="submit" class="btn-primary">Send note</button>
            </div>
          </form>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Offices -->
  <section class="relative overflow-hidden bg-paper-warm/60 py-24">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-paper to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-paper to-transparent"></div>

    <div class="container-edge relative">
      <SectionHeading eyebrow="Offices" title="Three desks. One house." />

      <div class="mt-12 grid gap-px overflow-hidden border border-ink/10 bg-ink/10 md:grid-cols-3">
        {offices.map((o) => (
          <Reveal>
            <div class="h-full bg-paper p-8">
              <div class="flex items-center justify-between">
                <h3 class="font-display text-2xl tracking-tight text-ink">{o.city}</h3>
                <span class="mono text-[0.68rem] tracking-wide text-ink-400">{o.tz}</span>
              </div>
              <div class="mono mt-2 text-[0.72rem] text-brass-600">{o.role}</div>
              <pre class="mt-6 whitespace-pre-wrap font-sans text-[0.9rem] leading-relaxed text-ink-500">{o.addr}</pre>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- Careers + Press -->
  <section id="careers" class="relative py-24">
    <div class="container-edge grid gap-6 md:grid-cols-2">
      <Reveal>
        <div class="relative overflow-hidden bg-ink p-10 text-paper">
          <div class="eyebrow text-brass-300">Careers</div>
          <h3 class="mt-4 font-display text-3xl tracking-tightest sm:text-4xl">Make software that feels like service.</h3>
          <p class="mt-4 max-w-md text-paper/70">We're 34 people across 3 cities. We ship weekly, we visit kitchens, and we believe craft is a posture.</p>
          <a href="#" class="btn-brass mt-8">See open roles</a>
        </div>
      </Reveal>
      <Reveal delay={120}>
        <div id="press" class="relative h-full overflow-hidden border border-ink/10 bg-paper p-10">
          <div class="eyebrow text-ink-500">Press</div>
          <h3 class="mt-4 font-display text-3xl tracking-tightest text-ink sm:text-4xl">Press kit & founders' notes.</h3>
          <p class="mt-4 max-w-md text-ink-500">Logo, type, founder quotes, and the essay on why hospitality software is still bad.</p>
          <a href="#" class="btn-ghost mt-8">Download press kit</a>
        </div>
      </Reveal>
    </div>
  </section>

</BaseLayout>
