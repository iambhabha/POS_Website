---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Reveal from '../components/Reveal.astro';

const members = [
  { name: 'Léo Desjardins',   role: 'Manager',          venue: 'Kenzo House',  perm: 'Owner',    last: '2 min ago',  initials: 'L', status: 'active' },
  { name: 'Ines Moreau',      role: 'Head of hospitality', venue: 'All',       perm: 'Admin',    last: '14 min ago', initials: 'I', status: 'active' },
  { name: 'Matteo Rinaldi',   role: 'GM',               venue: 'Aurum Bar',    perm: 'Manager',  last: '1h ago',     initials: 'M', status: 'active' },
  { name: 'Jun Watanabe',     role: 'Chef-owner',       venue: 'Hotel Kōya',   perm: 'Admin',    last: '3h ago',     initials: 'J', status: 'away' },
  { name: 'Anja Lindqvist',   role: 'Server',           venue: 'Kenzo House',  perm: 'Service',  last: 'yesterday',  initials: 'A', status: 'offline' },
  { name: 'Tomás Herrera',    role: 'Sommelier',        venue: 'Kenzo House',  perm: 'Service',  last: '2 days',     initials: 'T', status: 'offline' },
];

const venues = [
  { name: 'Kenzo House',   city: 'Copenhagen', type: 'Restaurant',     terminals: 6, covers: '142 / night', status: 'live' },
  { name: 'Aurum Bar',     city: 'Milan',      type: 'Bar',            terminals: 4, covers: '210 / night', status: 'live' },
  { name: 'Hotel Kōya',    city: 'Kyoto',      type: 'Hotel + F&B',    terminals: 9, covers: '84 + 42 rooms', status: 'live' },
  { name: 'Maison Rive',   city: 'Lyon',       type: 'Restaurant',     terminals: 3, covers: '66 / night',  status: 'onboarding' },
];

const audit = [
  { t: '18:41', who: 'Léo',    act: 'Voided ticket T-12',    meta: 'Manager override · reason: compliment',        kind: 'warn' },
  { t: '18:33', who: 'Service AI', act: 'Adjusted par for Chablis \'22', meta: 'From 34 → 48 · Friday uplift',   kind: 'info' },
  { t: '18:10', who: 'Anja',   act: 'Clocked in',             meta: 'Station: Front · Shift: 18:00–24:00',        kind: 'info' },
  { t: '17:55', who: 'Ines',   act: 'Approved supplier invoice', meta: 'Vindal AB · €2,842.50',                    kind: 'ok' },
  { t: '17:30', who: 'Léo',    act: 'Changed menu price',     meta: 'Uni linguine: €32 → €34',                    kind: 'info' },
  { t: '17:12', who: 'Matteo', act: 'Published roster',        meta: 'Week 18 · Aurum Bar · 11 staff',             kind: 'ok' },
];
---
<DashboardLayout title="Admin · Maison" section="Admin" venue="All properties" current="staff">

  <!-- Heading -->
  <div class="border-b border-ink/10">
    <div class="px-6 py-8 sm:px-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <Reveal>
          <div>
            <div class="eyebrow text-ink-500">Admin · all properties</div>
            <h1 class="mt-2 font-display text-4xl tracking-tightest text-ink sm:text-5xl">People, permissions, and provenance.</h1>
            <p class="mt-2 text-sm text-ink-500">34 team members · 4 venues · everything auditable.</p>
          </div>
        </Reveal>

        <Reveal delay={80} class="flex flex-wrap items-center gap-2">
          <button class="btn-ghost">Export audit log</button>
          <button class="btn-primary">Invite teammate</button>
        </Reveal>
      </div>
    </div>
  </div>

  <!-- Overview tiles -->
  <section class="grid gap-4 px-6 py-8 sm:px-10 md:grid-cols-2 lg:grid-cols-4">
    {[
      { label: 'Team members',  value: '34',  hint: '4 admins · 8 managers · 22 service' },
      { label: 'Active venues', value: '4',   hint: '1 onboarding' },
      { label: 'Monthly spend', value: '€4,128', hint: '22 terminals · Maison plan' },
      { label: 'Uptime · 90d',  value: '99.98%', hint: 'Last incident: 42 days ago' },
    ].map((t, i) => (
      <Reveal delay={i * 60}>
        <div class="border border-ink/10 bg-paper p-6">
          <div class="eyebrow text-ink-500">{t.label}</div>
          <div class="num mt-3 text-3xl tracking-tightest text-ink">{t.value}</div>
          <div class="mt-2 text-[0.72rem] text-ink-400">{t.hint}</div>
        </div>
      </Reveal>
    ))}
  </section>

  <!-- Members -->
  <section class="px-6 pb-8 sm:px-10">
    <Reveal>
      <div class="border border-ink/10 bg-paper">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 px-5 py-3">
          <div>
            <div class="eyebrow text-ink-500">Team · permissions</div>
            <div class="mt-0.5 text-sm text-ink">Who can do what, where.</div>
          </div>
          <div class="flex items-center gap-2">
            <div class="hidden items-center gap-2 border border-ink/15 px-3 py-1.5 text-xs text-ink-500 md:flex">
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4"/><path d="M10 10l3 3"/></svg>
              <span>Filter people…</span>
            </div>
            <button class="text-sm text-ink-500 hover:text-ink">+ Invite</button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full min-w-[720px] text-sm">
            <thead>
              <tr class="border-b border-ink/10 text-left text-ink-500">
                <th class="px-5 py-3 font-normal">Name</th>
                <th class="px-5 py-3 font-normal">Role</th>
                <th class="px-5 py-3 font-normal">Venue</th>
                <th class="px-5 py-3 font-normal">Permission</th>
                <th class="px-5 py-3 font-normal">Last active</th>
                <th class="px-5 py-3 font-normal"></th>
              </tr>
            </thead>
            <tbody>
              {members.map((m, i) => (
                <tr class={`border-b border-ink/5 transition-colors hover:bg-paper-warm/40 ${i === members.length - 1 ? 'border-b-0' : ''}`}>
                  <td class="px-5 py-4">
                    <div class="flex items-center gap-3">
                      <div class="relative flex h-9 w-9 items-center justify-center bg-ink/5 font-display text-sm text-ink">
                        {m.initials}
                        <span class={`absolute -right-0.5 -bottom-0.5 h-2.5 w-2.5 rounded-full border-2 border-paper
                          ${m.status === 'active' ? 'bg-green-500' : m.status === 'away' ? 'bg-brass-500' : 'bg-ink-300'}`}></span>
                      </div>
                      <span class="text-ink">{m.name}</span>
                    </div>
                  </td>
                  <td class="px-5 py-4 text-ink-500">{m.role}</td>
                  <td class="px-5 py-4 text-ink-500">{m.venue}</td>
                  <td class="px-5 py-4">
                    <span class={`chip ${
                      m.perm === 'Owner' ? 'border-brass-500 text-brass-700 bg-brass-50' :
                      m.perm === 'Admin' ? 'border-ink text-ink bg-ink/5' :
                      m.perm === 'Manager' ? 'bg-paper' : 'bg-paper text-ink-500'
                    }`}>{m.perm}</span>
                  </td>
                  <td class="px-5 py-4 mono text-[0.78rem] text-ink-400">{m.last}</td>
                  <td class="px-5 py-4 text-right">
                    <button class="text-[0.72rem] text-ink-500 hover:text-ink">Edit →</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </Reveal>
  </section>

  <!-- Venues + Audit log -->
  <section class="grid gap-4 px-6 pb-8 sm:px-10 xl:grid-cols-[1.1fr_1fr]">
    <!-- Venues -->
    <Reveal>
      <div class="border border-ink/10 bg-paper">
        <div class="flex items-center justify-between border-b border-ink/10 px-5 py-3">
          <div>
            <div class="eyebrow text-ink-500">Venues</div>
            <div class="mt-0.5 text-sm text-ink">Properties & devices under this account</div>
          </div>
          <button class="text-sm text-ink-500 hover:text-ink">+ Add venue</button>
        </div>
        <ul class="divide-y divide-ink/5">
          {venues.map((v) => (
            <li class="grid grid-cols-[1fr_auto_auto] items-center gap-6 px-5 py-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2 text-sm text-ink">
                  <span>{v.name}</span>
                  <span class={`h-1.5 w-1.5 rounded-full ${v.status === 'live' ? 'bg-green-500' : 'bg-brass-500'}`}></span>
                  <span class="mono text-[0.65rem] text-ink-400">{v.status.toUpperCase()}</span>
                </div>
                <div class="mt-0.5 text-[0.78rem] text-ink-500">{v.type} · {v.city}</div>
              </div>
              <div class="text-right text-[0.78rem] text-ink-500">
                <div class="mono text-ink">{v.terminals} terminals</div>
                <div class="mt-0.5">{v.covers}</div>
              </div>
              <a href="/dashboard" class="text-sm text-ink-500 hover:text-ink">Open →</a>
            </li>
          ))}
        </ul>
      </div>
    </Reveal>

    <!-- Audit log -->
    <Reveal delay={80}>
      <div class="border border-ink/10 bg-paper">
        <div class="flex items-center justify-between border-b border-ink/10 px-5 py-3">
          <div>
            <div class="eyebrow text-ink-500">Audit log · today</div>
            <div class="mt-0.5 text-sm text-ink">Everything touched, by whom, when.</div>
          </div>
          <button class="text-sm text-ink-500 hover:text-ink">Full log →</button>
        </div>
        <ol class="relative">
          {audit.map((a, i) => (
            <li class="relative grid grid-cols-[56px_16px_1fr] items-start gap-4 px-5 py-4">
              <span class="mono pt-1 text-[0.72rem] text-ink-400">{a.t}</span>
              <span class="relative flex justify-center pt-1.5">
                <span class={`h-2 w-2 rounded-full ${
                  a.kind === 'warn' ? 'bg-brass-500' : a.kind === 'ok' ? 'bg-green-600' : 'bg-ink-400'
                }`}></span>
                {i !== audit.length - 1 && <span class="absolute top-4 h-full w-px bg-ink/10"></span>}
              </span>
              <div class="min-w-0">
                <div class="text-sm text-ink"><span class="text-ink-500">{a.who} · </span>{a.act}</div>
                <div class="mt-0.5 text-[0.75rem] text-ink-500">{a.meta}</div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </Reveal>
  </section>

  <!-- Security -->
  <section class="px-6 pb-16 sm:px-10">
    <Reveal>
      <div class="grid gap-4 md:grid-cols-[1.2fr_1fr]">
        <div class="border border-ink/10 bg-paper p-8">
          <div class="eyebrow text-ink-500">Security</div>
          <h3 class="mt-3 font-display text-2xl tracking-tightest text-ink">Locked down, by default.</h3>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {[
              { t: 'Two-factor auth',  body: 'Required for Admin and Owner roles. TOTP and hardware keys supported.' },
              { t: 'SSO (SAML)',       body: 'Okta, Azure AD, Google Workspace. Available on Atelier Group.' },
              { t: 'Data residency',   body: 'EU-West by default · APAC and US available on request.' },
              { t: 'Backups',          body: 'Hourly, encrypted at rest with per-venue keys. 35-day retention.' },
            ].map((x) => (
              <div class="border-l border-ink/10 pl-4">
                <div class="text-sm text-ink">{x.t}</div>
                <div class="mt-1 text-[0.82rem] text-ink-500">{x.body}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="relative overflow-hidden bg-ink p-8 text-paper">
          <div class="eyebrow text-brass-300">Billing</div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="num text-4xl tracking-tightest">€4,128</span>
            <span class="text-sm text-paper/60">/ month</span>
          </div>
          <div class="mono mt-2 text-[0.68rem] text-paper/50">Maison · 22 terminals · billed monthly</div>

          <ul class="mt-6 space-y-2 border-t border-paper/15 pt-4 text-[0.85rem]">
            <li class="flex justify-between"><span class="text-paper/70">Next invoice</span><span class="mono">May 1 · Fri</span></li>
            <li class="flex justify-between"><span class="text-paper/70">Payment</span><span>•• 4912 · AMEX</span></li>
            <li class="flex justify-between"><span class="text-paper/70">Contract</span><span>Annual · 20% off</span></li>
          </ul>

          <div class="mt-6 flex gap-2">
            <a href="#" class="btn-brass">Change plan</a>
            <a href="#" class="inline-flex items-center border border-paper/20 px-4 py-2 text-sm text-paper transition-colors hover:border-paper">Invoices</a>
          </div>
        </div>
      </div>
    </Reveal>
  </section>

</DashboardLayout>
